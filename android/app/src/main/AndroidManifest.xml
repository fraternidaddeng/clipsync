<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Pairing and the peer health probe call the Windows peer over pinned TLS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Satisfies one network prerequisite of the connectedDevice foreground service type. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- QR scanning only; pairing also works by pasting the payload without camera access. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The sync session to the paired Windows peer runs as a connectedDevice foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- API 34+ prerequisite for the connectedDevice type on LAN (Wi-Fi) peers. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Status + inbox notifications (API 33+ runtime permission). Denial never blocks sync
         itself; items stay in the inbox and the in-app status must explain the missing surface. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wizard routes 2 and 3: the transient read-focus overlay, granted in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Wizard route 3: polling needs the app exempted from battery optimization. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
        Wizard route 2. READ_LOGS cannot be granted by any runtime dialog; the user grants it
        explicitly from a computer (`adb shell pm grant ... READ_LOGS`) and the app re-probes
        the real state on every resume — a past grant is never assumed permanent.
    -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".ClipSyncApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipSync">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets Shizuku hand this app its binder when the Shizuku service (re)starts. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 系统分享面板目标：纯文本写入本地 outbox，无界面。 -->
        <activity
            android:name=".platform.entry.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_target_label"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 快捷磁贴的透明宿主：取得焦点读取一次剪贴板后立即结束。 -->
        <activity
            android:name=".platform.entry.SendClipboardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ClipSync.Transparent" />

        <!-- 通知“复制”操作：仅携带事件 ID，正文在本地按 ID 查找。 -->
        <receiver
            android:name=".platform.notify.CopyInboxItemReceiver"
            android:exported="false" />

        <!-- Quick Settings 磁贴：发送当前剪贴板。 -->
        <service
            android:name=".platform.entry.SendClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_send_clip"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 与已配对 Windows 端保持同步会话的前台服务；通知只描述连接状态。 -->
        <service
            android:name=".sync.ClipboardSyncService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
