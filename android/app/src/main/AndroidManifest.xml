<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pairing calls the Windows peer's /v1/pair/confirm endpoint over pinned TLS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR scanning only; pairing also works by pasting the payload without camera access. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Optional. Denial must not crash; inbound copy notifications stay hidden. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Stage 5 connectedDevice FGS: keeps the Windows network session, not clipboard access. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Overlay is a read tool only. SYSTEM_ALERT_WINDOW does not grant
         background FGS start on Android 15+; do not start a transparent Activity. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- READ_LOGS cannot be granted by a normal runtime permission dialog.
         Only an explicit adb/privileged grant works; bootstrap prints the
         command and never auto-grants. Install, upgrade, or reboot invalidates it. -->
    <uses-permission android:name="android.permission.READ_LOGS" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".ClipSyncApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipSync">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".share.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:noHistory="true"
            android:theme="@style/Theme.ClipSync.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".tile.SendClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_send"
            android:label="@string/tile_send_clipboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".notify.CopyClipReceiver"
            android:exported="false" />

        <service
            android:name=".service.ClipboardSyncService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".service.BootCompletedReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku binder receiver. INTERACT_ACROSS_USERS_FULL is granted to
             shell, not normal apps; exported so the Shizuku server can push
             the binder. See RikkaApps/Shizuku-API README. -->
        <provider
            android:name=".platform.clipboard.shizuku.ClipSyncShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
