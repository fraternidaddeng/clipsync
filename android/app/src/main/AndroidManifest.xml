<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pairing calls the Windows peer's /v1/pair/confirm endpoint over pinned TLS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR scanning only; pairing also works by pasting the payload without camera access. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The sync session to the paired Windows peer runs as a connectedDevice foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- API 34+ prerequisite for the connectedDevice type on LAN (Wi-Fi) peers. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- The persistent "ClipSync 已连接" status notification on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipSync">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sync.ClipboardSyncService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
