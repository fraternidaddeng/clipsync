<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher tile background: the charter z0 day gradient (178° ≈ vertical,
     light above / dark below). One asset for both themes - the tile carries
     its own chrome; themed (dark) launchers use the monochrome layer instead. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0" android:color="#FFE9EFF6" />
                <item android:offset="0.42" android:color="#FFE2E9F2" />
                <item android:offset="1" android:color="#FFDAE3EE" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
