<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ClipSync</string>

    <!-- 系统入口 -->
    <string name="share_target_label">发送到电脑</string>
    <string name="qs_tile_label">发送剪贴板</string>

    <!-- 通知：正文永不包含剪贴板内容。所有渠道归入同一“剪贴同步”组，设置页里成组呈现 -->
    <string name="notification_group_name">剪贴同步</string>
    <string name="notification_group_description">同步状态、收到的文本与恢复提醒。所有通知均不显示剪贴板内容。</string>
    <string name="notification_channel_inbox_name">收到的文本</string>
    <string name="notification_channel_inbox_description">收到来自已配对电脑的新文本时提醒。通知从不显示剪贴板内容。</string>
    <string name="notification_inbox_title">来自电脑的新文本</string>
    <string name="notification_inbox_text">点按“复制”即可放入剪贴板</string>
    <string name="notification_action_copy">复制</string>
    <string name="notification_applied_text">已自动写入剪贴板</string>

    <!-- 同步前台服务通知：只描述连接状态 -->
    <string name="notification_channel_sync_name">同步状态</string>
    <string name="notification_channel_sync_description">与已配对电脑的连接状态。通知从不显示剪贴板内容。</string>
    <string name="notification_sync_connected">已连接 · 剪贴同步在线</string>
    <string name="notification_sync_connecting">正在连接电脑…</string>
    <string name="notification_sync_reconnecting">连接断开 · 等待重连</string>
    <string name="notification_sync_not_paired">未配对 · 同步待命</string>

    <!-- 前台服务通知操作（plan 5.2）：暂停全部同步 / 仅暂停自动捕获 / 立即同步；点按正文打开通路（故障状态）。均不含剪贴板内容 -->
    <string name="notification_action_pause_all">暂停同步</string>
    <string name="notification_action_resume_all">恢复同步</string>
    <string name="notification_action_pause_capture">暂停捕获</string>
    <string name="notification_action_resume_capture">恢复捕获</string>
    <string name="notification_action_sync_now">立即同步</string>
    <string name="notification_status_sync_paused">同步已暂停 · 收到的内容仅入收件箱</string>
    <string name="notification_status_capture_paused">自动捕获已暂停 · 手动发送与接收不受影响</string>

    <!-- 需要恢复：同步服务未能自动启动（开机恢复失败或系统拒绝前台服务） -->
    <string name="notification_channel_recovery_name">同步恢复提醒</string>
    <string name="notification_channel_recovery_description">同步服务无法自动恢复时提醒你打开应用手动恢复。通知从不显示剪贴板内容。</string>
    <string name="notification_recovery_title">需要恢复 · 剪贴同步未运行</string>
    <string name="notification_recovery_text">同步服务未能自动启动。点按打开应用手动恢复。</string>

    <!-- 对端限流：电脑端检测到本机反复认证失败，临时拒绝连接（镜像 Windows 托盘气泡） -->
    <string name="notification_auth_throttled_title">已被对端临时限流</string>
    <string name="notification_auth_throttled_text">电脑端检测到本机多次认证失败，已临时限流。约 30 秒后自动重试；若持续出现，请重新配对。</string>

    <!-- 发送结果提示 -->
    <string name="toast_share_enqueued">已加入发送队列，联机后同步到电脑</string>
    <string name="toast_share_empty">分享内容为空，未加入队列</string>
    <string name="toast_share_duplicate">相同内容刚刚已加入队列</string>
    <string name="toast_share_too_large">文本超过单条大小上限，未加入队列</string>
    <string name="toast_share_paused">同步已暂停，未加入队列</string>
    <string name="toast_share_private_mode">私密模式已开启，未加入队列</string>
    <string name="toast_share_unsupported">仅支持纯文本或 PNG/JPEG 图片分享</string>
    <string name="toast_share_image_enqueued">图片已加入发送队列，联机后同步到电脑</string>
    <string name="toast_share_image_disabled">图片同步未开启，可在偏好设置中打开</string>
    <string name="toast_share_image_invalid">仅支持大小合规的 PNG/JPEG 图片</string>
    <string name="toast_clipboard_empty">剪贴板没有可发送的文本</string>
    <string name="toast_clipboard_unavailable">无法读取剪贴板，请重试</string>

    <!-- 复制操作提示 -->
    <string name="toast_copied">已复制到剪贴板</string>
    <string name="toast_copy_failed">复制失败，请打开应用后重试</string>
    <string name="toast_copy_missing">该内容已不在收件箱中</string>
</resources>
