    <string name="theme_night">야간</string>
    <string name="prefs_language">언어</string>
    <string name="prefs_language_desc">UI 언어는 즉시 적용됩니다. 각 언어는 자신의 모국어 이름으로 표시되며 번역되지 않습니다.</string>
    <string name="prefs_language_follow_system">시스템 따름</string>
    <string name="prefs_group_sync">동기화</string>
    <string name="prefs_service_enabled">백그라운드 동기화 서비스</string>
    <string name="prefs_service_enabled_desc">끄면 백그라운드 서비스가 완전히 중지됩니다. 클립보드 백그라운드 감시와 페어링된 기기와의 연결·송수신이 멈추고 상주 알림도 사라지며, 앱을 다시 열거나 휴대폰을 재시작해도 저절로 재개되지 않습니다. 앱이 열려 있는 동안의 복사는 이 기기 기록에 계속 남고, 다시 켠 뒤에야 동기화됩니다. 아래의 「동기화 일시중지」와 달리 일시중지 중에는 서비스가 계속 실행됩니다.</string>
    <string name="prefs_pause_sync">동기화 일시중지</string>
    <string name="prefs_pause_sync_desc">일시중지 중에는 양쪽의 내용 교환이 멈춥니다. 기존 기록은 유지됩니다.</string>
    <string name="prefs_private_mode">비공개 모드</string>
    <string name="prefs_private_mode_desc">켜져 있는 동안 이 기기에서 복사한 내용은 기기를 벗어나지 않습니다.</string>
    <string name="prefs_auto_apply">클립보드 자동 쓰기</string>
    <string name="prefs_auto_apply_desc">상대 기기의 내용이 도착하면 이 기기의 클립보드에 자동으로 쓰는 것을 우선합니다.</string>
    <string name="prefs_image_sync">이미지 동기화</string>
    <string name="prefs_image_sync_desc">복사하거나 공유한 PNG/JPEG 이미지를 동기화합니다(항목당 최대 16 MiB). 양쪽 모두 켜야 하며 새 연결부터 적용됩니다.</string>
    <string name="prefs_auto_apply_images">원격 이미지 자동 쓰기</string>
    <string name="prefs_auto_apply_images_desc">상대 기기의 이미지를 이 기기의 클립보드에 자동으로 씁니다. 끄면 기록에만 남고 수동으로 복사해야 합니다.</string>
    <string name="prefs_group_bt">블루투스 대체 경로</string>
    <string name="prefs_bt_moved">통로 · 네트워크로 이동했습니다</string>
    <string name="prefs_group_capture">캡처</string>
    <string name="prefs_pause_capture">자동 캡처 일시중지</string>
    <string name="prefs_pause_capture_desc">켜져 있는 동안 이 기기에서 복사한 내용을 자동으로 읽지 않으며 백그라운드 읽기도 멈춥니다. 수동 보내기/받기는 계속 사용할 수 있습니다. 상주 알림의 ‘캡처 일시중지’와 같은 스위치입니다.</string>
    <string name="prefs_skip_sensitive">민감한 내용 건너뛰기</string>
    <string name="prefs_skip_sensitive_desc">원본 앱(비밀번호 관리자 등)이 민감으로 표시한 복사 내용은 기록과 동기화를 건너뜁니다. 원본 앱의 표시에 의존합니다. 공유 시트로 의도적으로 보내는 것은 제한하지 않습니다.</string>
    <string name="prefs_group_history">기록</string>
    <string name="prefs_auto_expire">만료 자동 정리</string>
    <string name="prefs_auto_expire_desc">만료된 기록 항목을 자동으로 삭제합니다. 삭제는 이 기기에만 적용됩니다.</string>
    <string name="prefs_retention_days">보관 기간</string>
    <plurals name="prefs_retention_days_value">
        <item quantity="other">%1$d일</item>
    </plurals>
    <string name="prefs_retention_forever">영구 보관</string>
    <string name="prefs_max_entries">보관 개수</string>
    <plurals name="prefs_max_entries_value">
        <item quantity="other">%1$d개</item>
    </plurals>
    <string name="prefs_item_cap">항목당 상한</string>
    <string name="prefs_item_cap_value">%1$s · 일반 텍스트</string>
    <string name="prefs_group_run">실행</string>
    <string name="prefs_boot_restore">부팅 시 복원</string>
    <string name="prefs_boot_restore_desc">재부팅 후 동기화 서비스를 자동으로 재개합니다. 시스템이 시작을 차단하면 알림으로 수동 재개를 안내합니다.</string>
    <string name="prefs_inbox_notify">수신 콘텐츠 알림</string>
    <string name="prefs_inbox_notify_desc">상대 기기의 내용이 도착하면 알립니다(내용 자체는 포함하지 않음). 끄면 동기화와 기록은 계속되고 알림만 멈춥니다.</string>
    <string name="prefs_group_data">데이터</string>
    <string name="prefs_export">기록 내보내기</string>
    <string name="prefs_export_desc">전체 기록(삭제 표시 포함)을 JSON Lines 백업 파일로 씁니다. 키나 페어링 데이터는 포함하지 않습니다. 내보내기는 평문입니다 — 안전하게 보관하세요.</string>
    <string name="prefs_import">기록 가져오기</string>
    <string name="prefs_import_desc">백업 파일에서 기록을 병합합니다. ‘원본 기기 + 시퀀스’ 기준으로 멱등이므로 다시 가져와도 중복되지 않습니다. 검증 실패 시 아무것도 바뀌지 않습니다.</string>
    <string name="prefs_clear_history">기록 지우기</string>
    <string name="prefs_clear_history_desc">이 기기의 모든 기록(이미지 포함)을 한 번에 삭제합니다. 상대 기기에는 영향이 없습니다. 확실하지 않으면 먼저 내보내세요.</string>
    <string name="prefs_clear_confirm_title">모든 기록을 지울까요?</string>
    <string name="prefs_clear_confirm_body">삭제는 이 기기에만 적용되며 되돌릴 수 없습니다. 상대 기기의 기록에는 영향이 없습니다. 확실하지 않으면 먼저 내보내세요.</string>
    <string name="prefs_clear_confirm_action">지우기 확정</string>
    <string name="prefs_group_device">기기</string>
    <string name="prefs_paired_device">페어링된 기기</string>
    <string name="prefs_manage_pairing">페어링 관리</string>
    <string name="prefs_conduit_network">통로 · 네트워크</string>
    <string name="prefs_no_device">아직 페어링된 기기가 없습니다</string>
    <string name="prefs_no_device_hint">페어링 입구는 통로 페이지의 네트워크 구간에 있습니다. 페어링하면 상대 기기의 이름이 여기에 표시됩니다.</string>

    <plurals name="transfer_export_done">
        <item quantity="other">%1$d개 기록을 내보냈습니다(평문). 백업 파일을 안전하게 보관하세요.</item>
    </plurals>
    <string name="transfer_export_failed">내보내기 실패: 선택한 파일에 쓸 수 없습니다.</string>
    <string name="transfer_import_done">가져오기 완료: 추가 %1$d · 기존 %2$d · 충돌 %3$d</string>
    <string name="transfer_import_failed">가져오기 실패: %1$s. 아무것도 변경되지 않았습니다.</string>
    <string name="transfer_import_read_failed">가져오기 실패: 선택한 파일을 읽을 수 없습니다.</string>
    <plurals name="transfer_cleared">
        <item quantity="other">기록 %1$d개를 지웠습니다(이 기기만, 상대 기기에는 영향 없음).</item>
    </plurals>
    <string name="transfer_err_bad_header">ClipSync 기록 내보내기 파일이 아닙니다</string>
    <string name="transfer_err_version">파일 버전이 이 앱이 지원하는 것보다 새롭습니다</string>
    <string name="transfer_err_malformed">파일이 손상되었습니다(잘못된 레코드)</string>
    <string name="transfer_err_hash">파일이 손상되었습니다(해시 검증 실패)</string>
    <string name="transfer_err_count">파일이 불완전합니다(개수가 헤더와 일치하지 않음)</string>
    <string name="transfer_err_too_large">파일에 1 MiB를 초과하는 항목이 있습니다</string>
    <string name="transfer_err_unknown">알 수 없는 오류</string>

    <string name="onboarding_subtitle">클립보드가 휴대전화와 PC 사이를 조용히 흐릅니다.</string>
    <string name="onboarding_tab_history_desc">어느 쪽에서 복사했든 모두 여기에 모입니다. 항목을 누르면 이 기기에서 다시 복사할 수 있습니다.</string>
    <string name="onboarding_tab_conduit_desc">흐름의 모든 구간을 솔직하게 보여줍니다. PC 페어링 입구도 여기 — 네트워크 구간의 ‘페어링하기’입니다.</string>
    <string name="onboarding_tab_prefs_desc">동기화 일시중지, 비공개 모드, 보관 기간 — 모든 스위치는 실제로 작동하며 즉시 디스크에 저장됩니다.</string>
    <string name="onboarding_honesty_header">미리 솔직하게 말씀드립니다</string>
    <string name="onboarding_honesty_body">Android는 백그라운드 클립보드 읽기를 제한하며 ClipSync는 이를 숨기지 않습니다. 포그라운드에서는 자동 업로드하고, 백그라운드 읽기는 통로 페이지에서 원하는 경로 하나를 완료해야 합니다. 모든 능력은 실측 테스트로 판정되며 안 되는 것은 안 된다고 말합니다.</string>
    <string name="onboarding_skip">먼저 둘러보고 나중에 페어링</string>
    <string name="onboarding_next">계속</string>
    <string name="onboarding_back">이전</string>
    <string name="onboarding_skip_for_now">나중에 설정</string>
    <string name="onboarding_step_progress">%2$d단계 중 %1$d단계</string>
    <string name="onboarding_pair_fact_entry">페어링 입구는 ‘통로’ 페이지의 네트워크 구간에 고정되어 있어, 튜토리얼이 끝난 뒤에도 언제든 찾을 수 있습니다.</string>
    <string name="onboarding_pair_fact_verify">페어링 시 양쪽에 인증서 지문이 표시됩니다. 일치할 때만 확인하세요 — 다른 PC에 잘못 연결되는 것을 막는 단계입니다.</string>
    <string name="onboarding_pair_fact_service">페어링이 끝나면 네트워크 구간이 연결되고 동기화 서비스가 자동으로 시작됩니다.</string>
    <string name="onboarding_pair_done">컴퓨터 페어링이 끝났습니다 — 통로가 열렸습니다. 남은 안내를 계속 살펴보세요.</string>
    <string name="onboarding_read_body">앱이 포그라운드에 있는 동안은 언제나 클립보드를 읽을 수 있습니다. 백그라운드 읽기는 경로 하나를 골라 한 번만 설정하면 되며, 품질이 가장 높은 ‘특권 직접 읽기’를 추천합니다.</string>
    <string name="onboarding_route_recommended">추천</string>
    <string name="onboarding_wireless_debug_hint">USB 케이블이 없나요? 시스템 ‘개발자 옵션 → 무선 디버깅’을 켜면 PC에서 Wi-Fi로도 같은 원클릭 시작을 실행할 수 있습니다.</string>
    <string name="onboarding_perms_title">권한 한눈에 보기</string>
    <string name="onboarding_perms_body">권한은 필요한 순간에만 요청합니다. 여기서 각 권한의 용도를 먼저 밝혀 둡니다. 어느 것을 거부해도 포그라운드 복사와 히스토리는 그대로 동작합니다.</string>
    <string name="onboarding_perm_notifications">알림</string>
    <string name="onboarding_perm_notifications_desc">동기화 상태와 ‘수신됨’ 알림을 표시하며, 클립보드 내용은 절대 포함하지 않습니다.</string>
    <string name="onboarding_perm_overlay">오버레이</string>
    <string name="onboarding_perm_overlay_desc">오버레이 기반 백그라운드 읽기 경로에만 필요합니다. 해당 경로를 선택하지 않으면 요청하지 않습니다.</string>
    <string name="onboarding_perm_battery">배터리 최적화</string>
    <string name="onboarding_perm_battery_desc">제외하면 백그라운드 동기화가 더 안정적입니다. 제외하지 않아도 사용할 수 있지만 서비스가 시스템에 회수되기 쉽습니다.</string>
    <string name="onboarding_finish_title">준비 완료</string>
    <string name="onboarding_finish_body">먼저 PC와 페어링하세요. 백그라운드 읽기 경로 안내는 ‘통로’ 페이지에, 모든 스위치는 ‘환경설정’ 페이지에 있으며 언제든 돌아올 수 있습니다.</string>
    <string name="onboarding_open_wizard">통로 페이지에서 경로 안내 보기</string>

    <string name="prefs_group_help">도움말</string>
    <string name="prefs_replay_onboarding">튜토리얼 다시 보기</string>
    <string name="prefs_replay_onboarding_desc">환영 페이지부터 첫 실행 튜토리얼을 다시 진행합니다. 설정과 페어링은 바꾸지 않습니다.</string>
</resources>
