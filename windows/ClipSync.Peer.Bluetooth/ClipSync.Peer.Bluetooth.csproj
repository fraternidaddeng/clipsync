<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Dual-target (docs/bluetooth-fallback-plan.md phase 2): the bt1 listener stack
         (framing, handshake, transport, host) is portable net8.0 so ClipSync.Tests runs it
         on every CI host; only RfcommServer.cs (the WinRT RfcommServiceProvider seam) is
         compiled for the Windows TFM, which the WPF app consumes. -->
    <TargetFrameworks>net8.0;net8.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>ClipSync.Peer.Bluetooth</RootNamespace>
    <AssemblyName>ClipSync.Peer.Bluetooth</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClipSync.Peer\ClipSync.Peer.csproj" />
  </ItemGroup>
</Project>
