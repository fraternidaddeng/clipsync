<Window x:Class="ClipSync.App.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClipSync.App.Localization"
        Title="{x:Static loc:Strings.Detail_Title}"
        Width="560"
        Height="480"
        MinWidth="420"
        MinHeight="320"
        Background="{DynamicResource CsBgSolidBrush}"
        FontFamily="{StaticResource CsSans}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
    <!-- 开窗内容淡入与主窗页面切换同一语汇（PageFadeIn，减弱动效时硬切） -->
    <Grid Margin="24" Style="{StaticResource PageFadeGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="SourceText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CsText1Brush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="CreatedAtText"
                       Margin="0,4,0,0"
                       FontFamily="{StaticResource CsMono}"
                       FontSize="11"
                       Foreground="{DynamicResource CsText4Brush}" />
            <!-- 图片元数据是机器的声音（tokens §6）：安静的 Mono 注记行，
                 图片本体才是内容主角（用户反馈 2026-08-26） -->
            <TextBlock x:Name="ImageMetaText"
                       Margin="0,2,0,0"
                       FontFamily="{StaticResource CsMono}"
                       FontSize="11"
                       Foreground="{DynamicResource CsText4Brush}"
                       Visibility="Collapsed" />
        </StackPanel>
        <Grid Grid.Row="2">
            <!-- 正文只读：剪贴板正文永不进标题栏/日志；图片显示缩略图，缺图时退回元数据行 -->
            <TextBox x:Name="BodyText"
                     Padding="10,8"
                     AcceptsReturn="True"
                     Background="{DynamicResource CsSurfaceInBrush}"
                     BorderBrush="{DynamicResource CsLineBrush}"
                     BorderThickness="1"
                     FontSize="{DynamicResource CsDetailBodyFontSize}"
                     Foreground="{DynamicResource CsText2Brush}"
                     HorizontalScrollBarVisibility="Disabled"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <Border Background="{DynamicResource CsSurfaceInBrush}"
                    BorderBrush="{DynamicResource CsLineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    x:Name="PreviewBorder">
                <Image x:Name="PreviewImage"
                       Margin="8"
                       Stretch="Uniform" />
            </Border>
        </Grid>
        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Click="OnCopyClicked"
                    Content="{x:Static loc:Strings.Common_Copy}"
                    Padding="16,6"
                    Style="{StaticResource GhostFlowButton}" />
            <Button Margin="8,0,0,0"
                    Click="OnCloseClicked"
                    Content="{x:Static loc:Strings.Common_Close}"
                    IsCancel="True"
                    Padding="16,6"
                    Style="{StaticResource GhostQuietButton}" />
        </StackPanel>
    </Grid>
</Window>
