<Window x:Class="ClipSync.App.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClipSync.App.Localization"
        Title="{x:Static loc:Strings.Onboarding_WindowTitle}"
        Icon="/Assets/Icons/app.ico"
        Width="520"
        Height="680"
        ResizeMode="NoResize"
        Background="{DynamicResource CsBgSolidBrush}"
        FontFamily="{StaticResource CsSans}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <!-- 与主窗一致的自绘 chrome：首次引导是应用的第一印象，不该顶着系统白条出场 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 三席图标：与主窗导航同一几何（24 网格折线语汇） -->
        <Geometry x:Key="IconHistory">M10,3 H19 A2,2 0 0 1 21,5 V18 A2,2 0 0 1 19,20 H10 A2,2 0 0 1 8,18 V5 A2,2 0 0 1 10,3 Z M16,3 V1 H3 V15 H6</Geometry>
        <Geometry x:Key="IconPrefs">M4,6 H12.3 M17.7,6 H20 M17.2,6 A2.2,2.2 0 1 0 12.8,6 A2.2,2.2 0 1 0 17.2,6 M4,12 H6.3 M11.7,12 H20 M11.2,12 A2.2,2.2 0 1 0 6.8,12 A2.2,2.2 0 1 0 11.2,12 M4,18 H13.3 M18.7,18 H20 M18.2,18 A2.2,2.2 0 1 0 13.8,18 A2.2,2.2 0 1 0 18.2,18</Geometry>
        <Geometry x:Key="IconPair">M4,8 V5.5 A1.5,1.5 0 0 1 5.5,4 H8 M16,4 H18.5 A1.5,1.5 0 0 1 20,5.5 V8 M20,16 V18.5 A1.5,1.5 0 0 1 18.5,20 H16 M8,20 H5.5 A1.5,1.5 0 0 1 4,18.5 V16 M7.5,12 H9.5 L10.5,9.6 L13.5,14.4 L14.5,12 H16.5</Geometry>
        <Geometry x:Key="IconNetwork">M5,12.5 A7,7 0 0 1 19,12.5 M8.5,16 A3.5,3.5 0 0 1 15.5,16 M13,19.5 A1,1 0 1 0 11,19.5 A1,1 0 1 0 13,19.5</Geometry>

        <!-- 引导专用轻语汇 -->
        <Style x:Key="ObIconStroke" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource CsFlowBrush}" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <!-- 顶部条的「上一步 / 稍后设置」：安静文字钮，跳过被允许而不被推销 -->
        <Style x:Key="ObQuietLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsSurface3Brush}" />
                                <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 步骤卡：与主窗 GroupCard 同语汇的静态卡面（引导内容短，免去阴影三层嵌套） -->
        <Style x:Key="ObCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CsSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CsLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!-- 安静注记盒：诚实不是警告，不用赭色 -->
        <Style x:Key="ObQuietNote" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CsSurface3Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CsLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="14,11" />
        </Style>
        <Style x:Key="ObStepTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CsSerif}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ObStepBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,8,4,0" />
        </Style>
        <Style x:Key="ObRowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
        </Style>
        <Style x:Key="ObRowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource CsBgBrush}">

        <!-- 标题栏：折线标记 + 窗名 -->
        <Border DockPanel.Dock="Top"
                Height="42"
                Padding="16,0,0,0"
                Background="{DynamicResource CsSurface3Brush}"
                BorderBrush="{DynamicResource CsLineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconConduit}" Style="{StaticResource ObIconStroke}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CsSerif}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CsText1Brush}"
                               Text="{x:Static loc:Strings.Onboarding_WindowTitle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        AutomationProperties.Name="{x:Static loc:Strings.Common_Close}"
                        Click="OnCloseClicked"
                        Style="{StaticResource CsCaptionCloseButton}">
                    <Path Data="{StaticResource CsGlyphClose}" Style="{StaticResource CsCaptionGlyph}" />
                </Button>
            </Grid>
        </Border>

        <!-- 底部动作区：一屏唯一实心主角；收尾步换成「前往通路页」+ 幽灵「开始使用」 -->
        <Border DockPanel.Dock="Bottom" Padding="24,12,24,18">
            <Grid>
                <Button x:Name="NextButton"
                        MinWidth="150"
                        HorizontalAlignment="Right"
                        Click="OnNextClicked"
                        Content="{x:Static loc:Strings.Onboarding_Next}"
                        Style="{StaticResource PrimaryButton}" />
                <StackPanel x:Name="FinishPanel"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <Button MinWidth="110"
                            Click="OnStartUsingClicked"
                            Content="{x:Static loc:Strings.Onboarding_StartUsing}"
                            Style="{StaticResource GhostQuietButton}" />
                    <Button MinWidth="150"
                            Margin="10,0,0,0"
                            Click="OnOpenConduitClicked"
                            Content="{x:Static loc:Strings.Onboarding_OpenConduit}"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 步骤条：上一步 / 进度点阵 / 稍后设置——每一步都不困人 -->
        <Grid DockPanel.Dock="Top"
              Height="34"
              Margin="16,8,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    HorizontalAlignment="Left"
                    Click="OnBackClicked"
                    Style="{StaticResource ObQuietLink}"
                    Visibility="Hidden">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="13" Text="‹" />
                    <TextBlock Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Text="{x:Static loc:Strings.Onboarding_Back}" />
                </StackPanel>
            </Button>
            <StackPanel x:Name="DotsPanel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal" />
            <Button x:Name="SkipButton"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Click="OnSkipClicked"
                    Content="{x:Static loc:Strings.Onboarding_SkipForNow}"
                    Style="{StaticResource ObQuietLink}" />
        </Grid>

        <ScrollViewer Padding="24,4,24,0" VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- ============ 1 · 欢迎 ============ -->
                <Grid x:Name="StepWelcome" Style="{StaticResource PageFadeGrid}">
                    <StackPanel Margin="0,14,0,12">
                        <Viewbox Width="34" Height="34" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconConduit}" Style="{StaticResource ObIconStroke}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Margin="0,12,0,0"
                                   FontFamily="{StaticResource CsSerif}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource CsText1Brush}"
                                   HorizontalAlignment="Center"
                                   Text="{x:Static loc:Strings.App_Name}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource ObStepBody}"
                                   Text="{x:Static loc:Strings.Onboarding_Subtitle}" />
                        <Border Margin="0,20,0,0" Style="{StaticResource ObCard}">
                            <StackPanel>
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Top">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconHistory}" Style="{StaticResource ObIconStroke}" />
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Style="{StaticResource ObRowTitle}" Text="{x:Static loc:Strings.Nav_History}" />
                                        <TextBlock Style="{StaticResource ObRowDesc}" Text="{x:Static loc:Strings.Onboarding_Tab_History_Desc}" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1"
                                        Margin="14,0"
                                        Background="{DynamicResource CsLineBrush}" />
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Top">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconConduit}" Style="{StaticResource ObIconStroke}" />
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Style="{StaticResource ObRowTitle}" Text="{x:Static loc:Strings.Nav_Conduit}" />
                                        <TextBlock Style="{StaticResource ObRowDesc}" Text="{x:Static loc:Strings.Onboarding_Tab_Conduit_Desc}" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1"
                                        Margin="14,0"
                                        Background="{DynamicResource CsLineBrush}" />
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Top">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource IconPrefs}" Style="{StaticResource ObIconStroke}" />
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Style="{StaticResource ObRowTitle}" Text="{x:Static loc:Strings.Nav_Prefs}" />
                                        <TextBlock Style="{StaticResource ObRowDesc}" Text="{x:Static loc:Strings.Onboarding_Tab_Prefs_Desc}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,14,0,0" Style="{StaticResource ObQuietNote}">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource CsMono}"
                                           FontSize="10"
                                           Foreground="{DynamicResource CsText4Brush}"
                                           Text="{x:Static loc:Strings.Onboarding_Honesty_Header}" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource CsText3Brush}"
                                           Text="{x:Static loc:Strings.Onboarding_Honesty_Body}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============ 2 · 配对（真二维码，不是示意图） ============ -->
                <Grid x:Name="StepPair"
                      Style="{StaticResource PageFadeGrid}"
                      Visibility="Collapsed">
                    <StackPanel Margin="0,14,0,12">
                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconPair}" Style="{StaticResource ObIconStroke}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource ObStepTitle}"
                                   Text="{x:Static loc:Strings.Pairing_Title}" />
                        <TextBlock Style="{StaticResource ObStepBody}" Text="{x:Static loc:Strings.Onboarding_Pair_Body}" />

                        <!-- 二维码：静区必须纯白；机器像素钉回 LTR -->
                        <StackPanel x:Name="QrPanel" Margin="0,16,0,0">
                            <Border HorizontalAlignment="Center"
                                    Padding="10"
                                    Background="{DynamicResource CsQrQuietBrush}"
                                    BorderBrush="{DynamicResource CsLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    FlowDirection="LeftToRight">
                                <Image x:Name="QrImage"
                                       Width="200"
                                       Height="200"
                                       AutomationProperties.Name="{x:Static loc:Strings.Pairing_ScanInstruction}"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       SnapsToDevicePixels="True" />
                            </Border>
                            <!-- 倒计时是机器的声音：Mono -->
                            <TextBlock x:Name="CountdownText"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource CsMono}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource CsText4Brush}" />
                            <!-- 核对卡：电脑名 + 证书指纹（配对前手机上核对） -->
                            <Border Margin="0,12,0,0"
                                    Padding="14,10"
                                    Style="{StaticResource ObCard}">
                                <StackPanel>
                                    <TextBlock FontFamily="{StaticResource CsMono}"
                                               FontSize="10"
                                               Foreground="{DynamicResource CsText4Brush}"
                                               Text="{x:Static loc:Strings.Pairing_VerifyHeading}" />
                                    <TextBlock Margin="0,7,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource CsText3Brush}"
                                               Text="{x:Static loc:Strings.Pairing_PcName}" />
                                    <TextBlock x:Name="DeviceNameText"
                                               Margin="0,1,0,0"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource CsText1Brush}" />
                                    <TextBlock Margin="0,7,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource CsText3Brush}"
                                               Text="{x:Static loc:Strings.Pairing_Fingerprint}" />
                                    <TextBlock x:Name="FingerprintText"
                                               Margin="0,2,0,0"
                                               FlowDirection="LeftToRight"
                                               FontFamily="{StaticResource CsMono}"
                                               FontSize="11.5"
                                               LineHeight="18"
                                               Foreground="{DynamicResource CsText1Brush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 无可达地址 / 对端未启动 = 需要你操作（赭色着色盒），不是错误 -->
                        <Border x:Name="PairNoteBox"
                                Margin="0,14,0,0"
                                Padding="12,10"
                                Background="{DynamicResource CsActBgBrush}"
                                BorderBrush="{DynamicResource CsActLineBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Visibility="Collapsed">
                            <TextBlock x:Name="PairNoteText"
                                       FontSize="11"
                                       Foreground="{DynamicResource CsActBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- 引导期间配对完成：流动蓝陈述事实，继续走完剩下的步骤 -->
                        <Border x:Name="PairDoneBox"
                                Margin="0,14,0,0"
                                Padding="12,10"
                                Background="{DynamicResource CsFlowBgBrush}"
                                BorderBrush="{DynamicResource CsFlowLineBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Visibility="Collapsed">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource CsFlowBrush}"
                                       Text="{x:Static loc:Strings.Onboarding_Pair_Done}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============ 3 · 特权直读 ============ -->
                <Grid x:Name="StepPrivileged"
                      Style="{StaticResource PageFadeGrid}"
                      Visibility="Collapsed">
                    <StackPanel Margin="0,14,0,12">
                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconPhone}" Style="{StaticResource ObIconStroke}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource ObStepTitle}"
                                   Text="{x:Static loc:Strings.Conduit_Privileged_Header}" />
                        <TextBlock Style="{StaticResource ObStepBody}" Text="{x:Static loc:Strings.Onboarding_Privileged_Body}" />
                        <Border Margin="0,16,0,0" Style="{StaticResource ObCard}">
                            <StackPanel>
                                <StackPanel Margin="14,12">
                                    <TextBlock Style="{StaticResource ObRowTitle}" Text="{x:Static loc:Strings.Onboarding_Privileged_UsbTitle}" />
                                    <TextBlock Style="{StaticResource ObRowDesc}" Text="{x:Static loc:Strings.Onboarding_Privileged_UsbDesc}" />
                                </StackPanel>
                                <Border Height="1"
                                        Margin="14,0"
                                        Background="{DynamicResource CsLineBrush}" />
                                <StackPanel Margin="14,12">
                                    <TextBlock Style="{StaticResource ObRowTitle}" Text="{x:Static loc:Strings.Onboarding_Privileged_WirelessTitle}" />
                                    <TextBlock Style="{StaticResource ObRowDesc}" Text="{x:Static loc:Strings.Onboarding_Privileged_WirelessDesc}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,14,0,0" Style="{StaticResource ObQuietNote}">
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource CsText3Brush}"
                                       Text="{x:Static loc:Strings.Onboarding_Privileged_Consent}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============ 4 · 蓝牙备援（可选一提） ============ -->
                <Grid x:Name="StepBluetooth"
                      Style="{StaticResource PageFadeGrid}"
                      Visibility="Collapsed">
                    <StackPanel Margin="0,14,0,12">
                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconNetwork}" Style="{StaticResource ObIconStroke}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource ObStepTitle}"
                                   Text="{x:Static loc:Strings.Conduit_Bluetooth_Title}" />
                        <TextBlock Style="{StaticResource ObStepBody}" Text="{x:Static loc:Strings.Onboarding_Bt_Body}" />
                        <Border Margin="0,16,0,0" Style="{StaticResource ObQuietNote}">
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource CsText3Brush}"
                                       Text="{x:Static loc:Strings.Onboarding_Bt_Note}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============ 5 · 就绪 ============ -->
                <Grid x:Name="StepFinish"
                      Style="{StaticResource PageFadeGrid}"
                      Visibility="Collapsed">
                    <StackPanel Margin="0,64,0,12">
                        <Viewbox Width="34" Height="34" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconConduit}" Style="{StaticResource ObIconStroke}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Margin="0,14,0,0"
                                   FontSize="20"
                                   Style="{StaticResource ObStepTitle}"
                                   Text="{x:Static loc:Strings.Onboarding_Finish_Title}" />
                        <TextBlock Margin="12,8,12,0"
                                   Style="{StaticResource ObStepBody}"
                                   Text="{x:Static loc:Strings.Onboarding_Finish_Body}" />
                    </StackPanel>
                </Grid>

            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
