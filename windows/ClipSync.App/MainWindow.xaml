<Window x:Class="ClipSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:ClipSync.App.Ui"
        xmlns:loc="clr-namespace:ClipSync.App.Localization"
        Title="{x:Static loc:Strings.App_WindowTitle}"
        Icon="Assets/Icons/app.ico"
        Width="1020"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        Background="{DynamicResource CsBgSolidBrush}"
        FontFamily="{StaticResource CsSans}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <!-- Native frame removed: the charter grey-blue chrome extends into the
         title bar; DWM keeps the shadow, snap layouts and resize borders. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="45"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 色彩令牌与字体/按钮族来自 App 级 Resources/（CharterTokens / CharterControls）。
             此处仅保留本窗口私有的图标几何与样式。 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <ui:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
        <!-- 设备邻近色按配对顺位取 dev-1..dev-5（tokens §4）；顺位 0 = 灰（本机/已不在册的来源） -->
        <ui:DeviceAccentBrushConverter x:Key="DeviceAccentBrush" />
        <!-- 字符串键设置 ↔ 单选 chip 组（显示组的历史字号/预览行数） -->
        <ui:StringMatchToBoolConverter x:Key="StringMatch" />

        <!-- ============ 图标几何（docs/design/icons/*.svg 的 Path 转写；IconConduit/IconPhone 已上移 App 级）============ -->
        <Geometry x:Key="IconHistory">M10,3 H19 A2,2 0 0 1 21,5 V18 A2,2 0 0 1 19,20 H10 A2,2 0 0 1 8,18 V5 A2,2 0 0 1 10,3 Z M16,3 V1 H3 V15 H6</Geometry>
        <Geometry x:Key="IconPrefs">M4,6 H12.3 M17.7,6 H20 M17.2,6 A2.2,2.2 0 1 0 12.8,6 A2.2,2.2 0 1 0 17.2,6 M4,12 H6.3 M11.7,12 H20 M11.2,12 A2.2,2.2 0 1 0 6.8,12 A2.2,2.2 0 1 0 11.2,12 M4,18 H13.3 M18.7,18 H20 M18.2,18 A2.2,2.2 0 1 0 13.8,18 A2.2,2.2 0 1 0 18.2,18</Geometry>
        <Geometry x:Key="IconService">M15,12 A3,3 0 1 0 9,12 A3,3 0 1 0 15,12 M12,2 V5 M12,19 V22 M4.2,4.2 L6.3,6.3 M17.7,17.7 L19.8,19.8 M2,12 H5 M19,12 H22</Geometry>
        <Geometry x:Key="IconNetwork">M5,12.5 A7,7 0 0 1 19,12.5 M8.5,16 A3.5,3.5 0 0 1 15.5,16 M13,19.5 A1,1 0 1 0 11,19.5 A1,1 0 1 0 13,19.5</Geometry>
        <Geometry x:Key="IconPair">M4,8 V5.5 A1.5,1.5 0 0 1 5.5,4 H8 M16,4 H18.5 A1.5,1.5 0 0 1 20,5.5 V8 M20,16 V18.5 A1.5,1.5 0 0 1 18.5,20 H16 M8,20 H5.5 A1.5,1.5 0 0 1 4,18.5 V16 M7.5,12 H9.5 L10.5,9.6 L13.5,14.4 L14.5,12 H16.5</Geometry>
        <Geometry x:Key="IconDevices">M3.5,4 H12.5 A1.5,1.5 0 0 1 14,5.5 V11.5 A1.5,1.5 0 0 1 12.5,13 H3.5 A1.5,1.5 0 0 1 2,11.5 V5.5 A1.5,1.5 0 0 1 3.5,4 Z M6,16.5 H10.5 M8.25,13 V16.5 M18,8 H20.5 A2,2 0 0 1 22.5,10 V18 A2,2 0 0 1 20.5,20 H18 A2,2 0 0 1 16,18 V10 A2,2 0 0 1 18,8 Z M18.5,17.2 H20</Geometry>
        <Geometry x:Key="IconSearch">M10.5,4 A6.5,6.5 0 1 0 10.5,17 A6.5,6.5 0 1 0 10.5,4 M15.4,15.4 L20,20</Geometry>
        <!-- 相框 + 山形 + 斜杠：缩略图缺失时的「无预览」占位 -->
        <Geometry x:Key="IconNoPreview">M6,4.5 H18 A1.5,1.5 0 0 1 19.5,6 V18 A1.5,1.5 0 0 1 18,19.5 H6 A1.5,1.5 0 0 1 4.5,18 V6 A1.5,1.5 0 0 1 6,4.5 Z M4.5,15.5 L9.5,10.5 L13,14 M14.5,12.5 L16,11 L19.5,14.5 M4,4 L20,20</Geometry>
        <!-- 三行文字线：文本条目在统一 56px 左槽里的安静占位字形 -->
        <Geometry x:Key="IconClipText">M5,7 H19 M5,12 H16 M5,17 H12</Geometry>
        <!-- 形态类型字形（24 网格单色线性，icons.md §一）：文本条目左槽的类型提示，
             与 ADR 0003 注记盒同一邻近色槽位——左槽自此携带信息，不再是空占位框 -->
        <Geometry x:Key="IconFormatLink">M10,13 A5,5 0 0 0 17.54,13.54 L20.54,10.54 A5,5 0 0 0 13.47,3.47 L11.75,5.18 M14,11 A5,5 0 0 0 6.46,10.46 L3.46,13.46 A5,5 0 0 0 10.53,20.53 L12.24,18.82</Geometry>
        <Geometry x:Key="IconFormatEmail">M5.5,5.5 H18.5 A1.5,1.5 0 0 1 20,7 V17 A1.5,1.5 0 0 1 18.5,18.5 H5.5 A1.5,1.5 0 0 1 4,17 V7 A1.5,1.5 0 0 1 5.5,5.5 Z M4.5,7.5 L12,13 L19.5,7.5</Geometry>
        <Geometry x:Key="IconFormatOtp">M12,6.5 V17.5 M7.2,9.25 L16.8,14.75 M16.8,9.25 L7.2,14.75</Geometry>
        <Geometry x:Key="IconFormatCredential">M10.5,12 H20 M16.5,12 V15 M20,12 V15.5 M4,12 A3.25,3.25 0 1 0 10.5,12 A3.25,3.25 0 1 0 4,12</Geometry>

        <!-- ============ 控件样式 ============ -->
        <!-- 页面切换过渡 PageFadeIn / PageFadeGrid / PageFadeScroll 已上移 App 级
             CharterControls.xaml（详情窗共用同一语汇）。 -->

        <!-- 左栏导航项：图标 + 文字，选中 = 流动蓝着色盒 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource CsText4Brush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Padding="4,9,4,7"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource CsFlowBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsFlowBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CsFlowLineBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource CsText2Brush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsSurfaceBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关：凹槽轨道 + 抬起的钮；开 = 轨道充上流动蓝 -->
        <Style x:Key="CharterToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Width="40"
                                Height="22"
                                Background="{DynamicResource CsSurfaceInBrush}"
                                BorderBrush="{DynamicResource CsLine2Brush}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <Border x:Name="Knob"
                                    Width="16"
                                    Height="16"
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource CsSurfaceUpBrush}"
                                    BorderBrush="{DynamicResource CsLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource CsFlowBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource CsFlowBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 折叠区把手（缺省即隐藏）：文字 + 旋转箭头，不是开关——展开一段可选内容，
             不改任何设置。当前唯一使用者是特权直读卡的无线配对段 -->
        <Style x:Key="FoldToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource CsText2Brush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Padding="2,4" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Chevron"
                                      Margin="0,1,7,0"
                                      VerticalAlignment="Center"
                                      Data="M0,0 L4,4 L0,8"
                                      RenderTransformOrigin="0.5,0.5"
                                      Stroke="{DynamicResource CsText3Brush}"
                                      StrokeThickness="1.4">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 形态筛选 chip（ADR 0003）：选中 = 流动蓝着色盒（与导航同一词汇），
             未选中留在安静的灰族 -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Padding="10,4"
                                Background="{DynamicResource CsSurface3Brush}"
                                BorderBrush="{DynamicResource CsLineBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource CsFlowBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsFlowBgBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CsFlowLineBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource CsText2Brush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsSurfaceBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 步进器 −/＋ 钮 -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsSurface3Brush}" />
                                <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 凹陷输入框（z−1：比底更暗） -->
        <Style x:Key="InsetTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CsSurfaceInBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CsLineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource CsText1Brush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CsFlowLineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 凹陷下拉框（语言选择器，P1#16）：闭合态与凹陷输入框同一 z−1 语汇，
             弹出面用 z1 卡片底 + 1px 线；19 种语言 chip 放不下，这是偏好页唯一的下拉 -->
        <Style x:Key="InsetComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CsSurfaceInBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CsLineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsSurface3Brush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsFlowBgBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource CsFlowBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      IsHitTestVisible="False" />
                                    <Path Grid.Column="1"
                                          Margin="0,1,10,0"
                                          VerticalAlignment="Center"
                                          Data="M0,0 L4,4 L8,0"
                                          Stroke="{DynamicResource CsText3Brush}"
                                          StrokeThickness="1.4" />
                                </Grid>
                            </Border>
                            <ToggleButton ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="{DynamicResource CsSurfaceBrush}"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CsFlowLineBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CsFlowLineBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- z1 卡片组：与历史卡/通路段同一套 tokens §8 三层嵌套——
             最外层 sh-1 阴影（文字在中层渲染，不进 Effect 子树，保住 ClearType）、
             中层 1px 边框 + sf-grad 受光、最内 2px 顶部高光 -->
        <Style x:Key="GroupCard" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Background="{DynamicResource CsSurfaceBrush}"
                                    CornerRadius="12"
                                    Effect="{DynamicResource CsSh1Effect}" />
                            <Border Background="{DynamicResource CsSurfaceGradBrush}"
                                    BorderBrush="{DynamicResource CsLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Border Height="2"
                                            Margin="1,1,1,0"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource CsEdgeBrush}"
                                            CornerRadius="11,11,0,0" />
                                    <ContentPresenter />
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 组头：Mono、全大写语汇、t4 -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CsMono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource CsText4Brush}" />
            <Setter Property="Margin" Value="16,11,16,0" />
        </Style>

        <!-- 页标题（Serif 17）与副标 -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CsSerif}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
        </Style>
        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
            <Setter Property="Margin" Value="0,2,0,16" />
        </Style>

        <!-- 偏好行：名 + 说明 -->
        <Style x:Key="RowName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- 通路段卡片内部文字 -->
        <Style x:Key="SegName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SegStatus" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CsMono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="SegDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 历史条目容器：z1 卡片（tokens §8 三层嵌套：外层 sh-1 阴影、中层 1px 边框、
             内层 2px 顶部高光），悬停抬到 z2（阴影跳 sh-2 + 1px 上移），选中描流动蓝 -->
        <Style x:Key="HistoryItemContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="Root" Margin="0,0,0,8">
                            <!-- 最外层：面色 + 阴影（文字在中层渲染，不进 Effect 子树，保住 ClearType） -->
                            <Border x:Name="Fill"
                                    Background="{DynamicResource CsSurfaceBrush}"
                                    CornerRadius="10"
                                    Effect="{DynamicResource CsSh1Effect}" />
                            <!-- 中层：1px 边框 + sf-grad 受光；最内：2px 顶部高光条 -->
                            <Border x:Name="Card"
                                    Background="{DynamicResource CsSurfaceGradBrush}"
                                    BorderBrush="{DynamicResource CsLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Border Height="2"
                                            Margin="1,1,1,0"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource CsEdgeBrush}"
                                            CornerRadius="9,9,0,0" />
                                    <ContentPresenter Margin="14,10" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource CsSurfaceUpBrush}" />
                                <Setter TargetName="Fill" Property="Effect" Value="{DynamicResource CsSh2Effect}" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource CsSurfaceUpBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CsFlowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通路段卡片外衣：与历史卡同一套三层嵌套（对齐 pc-settings-preview 的 .hseg：
             sf 底 + sf-grad 受光 + 1px ln + 圆角 11 + sh-1 + 顶部高光） -->
        <Style x:Key="SegCard" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Background="{DynamicResource CsSurfaceBrush}"
                                    CornerRadius="11"
                                    Effect="{DynamicResource CsSh1Effect}" />
                            <Border Background="{DynamicResource CsSurfaceGradBrush}"
                                    BorderBrush="{DynamicResource CsLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <Grid>
                                    <Border Height="2"
                                            Margin="1,1,1,0"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource CsEdgeBrush}"
                                            CornerRadius="10,10,0,0" />
                                    <ContentPresenter Margin="12,11" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设备行容器 -->
        <Style x:Key="DeviceItemContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Padding="16,10"
                                Background="Transparent"
                                BorderBrush="{DynamicResource CsLineBrush}"
                                BorderThickness="0,1,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource CsSurface3Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource CsFlowBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 最大化时 DWM 会把窗口向外扩 7px，用内边距补回，避免边缘内容被裁掉 -->
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <DockPanel Background="{DynamicResource CsBgBrush}">

        <!-- ============ 标题栏（自绘 chrome）：折线标记 + 品牌名 + 暂停/私密开关 + 四段 mini rail + 窗控 ============ -->
        <Border DockPanel.Dock="Top"
                Height="45"
                Padding="16,0,0,0"
                Background="{DynamicResource CsSurface3Brush}"
                BorderBrush="{DynamicResource CsLineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconConduit}"
                                  Stroke="{DynamicResource CsFlowBrush}"
                                  StrokeThickness="1.9"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CsSerif}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CsText1Brush}"
                               Text="{x:Static loc:Strings.Brand_Wordmark}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource CsText3Brush}"
                               Text="{x:Static loc:Strings.Common_PauseCapture}" />
                    <ToggleButton AutomationProperties.Name="{x:Static loc:Strings.Common_PauseCapture}"
                                  Click="OnSettingToggled"
                                  IsChecked="{Binding IsPaused}"
                                  Style="{StaticResource CharterToggle}" />
                    <TextBlock Margin="20,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource CsText3Brush}"
                               Text="{x:Static loc:Strings.Common_PrivateMode}" />
                    <ToggleButton AutomationProperties.Name="{x:Static loc:Strings.Common_PrivateMode}"
                                  Click="OnSettingToggled"
                                  IsChecked="{Binding IsPrivateMode}"
                                  Style="{StaticResource CharterToggle}" />
                </StackPanel>

                <!-- 四段 mini rail：捕获 / 服务 / 网络 / 对端 -->
                <StackPanel Grid.Column="2"
                            Margin="24,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Rectangle Width="14" Height="4" RadiusX="2" RadiusY="2">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{DynamicResource CsFlowBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource CsLine2Brush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPrivateMode}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource CsLine2Brush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <Rectangle Width="14"
                               Height="4"
                               Margin="3,0,0,0"
                               Fill="{DynamicResource CsFlowBrush}"
                               RadiusX="2"
                               RadiusY="2" />
                    <Rectangle Width="14" Height="4" Margin="3,0,0,0" RadiusX="2" RadiusY="2">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{DynamicResource CsLine2Brush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PeerOnline}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource CsFlowBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <Rectangle Width="14" Height="4" Margin="3,0,0,0" RadiusX="2" RadiusY="2">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{DynamicResource CsFlowBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                        <Setter Property="Fill" Value="{DynamicResource CsLine2Brush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                </StackPanel>

                <!-- 窗控三钮（关闭 = 隐藏到托盘，退出走托盘菜单） -->
                <StackPanel Grid.Column="3"
                            Margin="16,0,0,0"
                            Orientation="Horizontal">
                    <Button AutomationProperties.Name="{x:Static loc:Strings.Chrome_Minimize}"
                            Click="OnMinimizeClicked"
                            Style="{StaticResource CsCaptionButton}">
                        <Path Data="{StaticResource CsGlyphMinimize}" Style="{StaticResource CsCaptionGlyph}" />
                    </Button>
                    <Button AutomationProperties.Name="{x:Static loc:Strings.Chrome_MaximizeRestore}"
                            Click="OnMaxRestoreClicked"
                            Style="{StaticResource CsCaptionButton}">
                        <Path>
                            <Path.Style>
                                <Style BasedOn="{StaticResource CsCaptionGlyph}" TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource CsGlyphMaximize}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Data" Value="{StaticResource CsGlyphRestore}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button AutomationProperties.Name="{x:Static loc:Strings.Common_Close}"
                            Click="OnCloseClicked"
                            Style="{StaticResource CsCaptionCloseButton}">
                        <Path Data="{StaticResource CsGlyphClose}" Style="{StaticResource CsCaptionGlyph}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左栏导航：与 Android 底栏三页镜像 ============ -->
            <Border Padding="8,14"
                    Background="{DynamicResource CsSurface3Brush}"
                    BorderBrush="{DynamicResource CsLineBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel>
                    <RadioButton x:Name="NavHistory"
                                 GroupName="Nav"
                                 IsChecked="True"
                                 Style="{StaticResource NavItem}">
                        <StackPanel>
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconHistory}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="10.5"
                                       Text="{x:Static loc:Strings.Nav_History}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavConduit" GroupName="Nav" Style="{StaticResource NavItem}">
                        <StackPanel>
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconConduit}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="10.5"
                                       Text="{x:Static loc:Strings.Nav_Conduit}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPrefs" GroupName="Nav" Style="{StaticResource NavItem}">
                        <StackPanel>
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconPrefs}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="10.5"
                                       Text="{x:Static loc:Strings.Nav_Prefs}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- ============ 主区：三个位置 ============ -->
            <Grid Grid.Column="1">

                <!-- ———— 历史 ———— -->
                <Grid Margin="24,18,24,20"
                      Style="{StaticResource PageFadeGrid}"
                      Visibility="{Binding IsChecked, ElementName=NavHistory, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static loc:Strings.History_Title}" />
                        <TextBlock Style="{StaticResource PageSub}" Text="{x:Static loc:Strings.History_Subtitle}" />
                    </StackPanel>

                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Command="{Binding SearchCommand}"
                                Content="{x:Static loc:Strings.History_Search}"
                                Style="{StaticResource GhostFlowButton}" />
                        <TextBox Height="32"
                                 Style="{StaticResource InsetTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <!-- 形态筛选（ADR 0003）：渲染时按分类过滤，检索辅助，不写库 -->
                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,12"
                                Orientation="Horizontal">
                        <RadioButton Command="{Binding SetFormatFilterCommand}"
                                     CommandParameter="all"
                                     Content="{x:Static loc:Strings.Filter_All}"
                                     GroupName="HistoryFormatFilter"
                                     IsChecked="True"
                                     Style="{StaticResource FilterChip}" />
                        <RadioButton Command="{Binding SetFormatFilterCommand}"
                                     CommandParameter="link"
                                     Content="{x:Static loc:Strings.Filter_Link}"
                                     GroupName="HistoryFormatFilter"
                                     Style="{StaticResource FilterChip}" />
                        <RadioButton Command="{Binding SetFormatFilterCommand}"
                                     CommandParameter="otp"
                                     Content="{x:Static loc:Strings.Filter_Otp}"
                                     GroupName="HistoryFormatFilter"
                                     Style="{StaticResource FilterChip}" />
                        <RadioButton Command="{Binding SetFormatFilterCommand}"
                                     CommandParameter="email"
                                     Content="{x:Static loc:Strings.Filter_Email}"
                                     GroupName="HistoryFormatFilter"
                                     Style="{StaticResource FilterChip}" />
                        <RadioButton Command="{Binding SetFormatFilterCommand}"
                                     CommandParameter="credential"
                                     Content="{x:Static loc:Strings.Filter_Credential}"
                                     GroupName="HistoryFormatFilter"
                                     Style="{StaticResource FilterChip}" />
                        <RadioButton Command="{Binding SetFormatFilterCommand}"
                                     CommandParameter="plain"
                                     Content="{x:Static loc:Strings.Filter_Plain}"
                                     GroupName="HistoryFormatFilter"
                                     Style="{StaticResource FilterChip}" />
                    </StackPanel>

                    <!-- 超限不同步事实条：安静的 sf3 底 + 1px 线（同 Android 通知关闭条的语汇），
                         不是错误红——本机保留是协议承诺的事实，需要被说出而非被指责。
                         空字符串 = 隐藏；下一次成功捕获或点「知道了」即退场。 -->
                    <Border Grid.Row="3"
                            Margin="0,0,0,12"
                            Padding="12,8"
                            Background="{DynamicResource CsSurface3Brush}"
                            BorderBrush="{DynamicResource CsLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CaptureNotice}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DismissCaptureNoticeCommand}"
                                    Content="{x:Static loc:Strings.Common_Acknowledge}"
                                    Style="{StaticResource GhostQuietButton}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource CsText2Brush}"
                                       Text="{Binding CaptureNotice}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="4">
                        <!-- 长列表虚拟化：ListBox 默认已虚拟化（VirtualizingStackPanel），此处显式声明
                             并开启容器回收（Recycling），滚动时复用条目容器而非反复创建/析构，
                             上千条历史时显著降低布局与 GC 压力。视觉零变化。 -->
                        <ListBox Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource HistoryItemContainer}"
                                 ItemsSource="{Binding History}"
                                 MouseDoubleClick="OnHistoryItemDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectedItem="{Binding SelectedItem}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 统一 56px 左槽：所有条目共享同一纵向结构，标题/注记盒/元信息
                                             跨类型对齐（宪章间距 12）。图片=缩略图（FromEntry 一次解码并
                                             冻结，容器回收不再重解码；缓存损坏时自愈重建、blob 兜底），
                                             图片确实无像素可出=诚实「无预览」。文本条目撤掉凹陷框
                                             （sf-in 是缩略图槽的语汇，空框读作「缺了一张图」——用户反馈
                                             2026-08-26），改为无框的形态类型字形提示。 -->
                                        <Border Width="56"
                                                Height="56"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Top"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CsSurfaceInBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CsLineBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImage}" Value="False">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <!-- 文本条目类型提示：形态字形借该形态的邻近色（链接=水蓝、
                                                     邮箱=青灰、验证码=蓝紫、密码=藕紫），普通文本=安静灰
                                                     三行文字线——左槽支持内容类型而不与正文争抢 -->
                                                <Viewbox Width="22"
                                                         Height="22"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsImage, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Stroke="{Binding FormatAccentIndex, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Text}"
                                                              StrokeThickness="1.7"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Data" Value="{StaticResource IconClipText}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Format}" Value="Link">
                                                                            <Setter Property="Data" Value="{StaticResource IconFormatLink}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Format}" Value="Email">
                                                                            <Setter Property="Data" Value="{StaticResource IconFormatEmail}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Format}" Value="Otp">
                                                                            <Setter Property="Data" Value="{StaticResource IconFormatOtp}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Format}" Value="Credential">
                                                                            <Setter Property="Data" Value="{StaticResource IconFormatCredential}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Canvas>
                                                </Viewbox>
                                                <!-- 仅当 blob 缺失或真不可解码：诚实「无预览」，用 text-3 保证可辨 -->
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding ShowsNoPreview, Converter={StaticResource BoolToVisibility}}">
                                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="{StaticResource IconNoPreview}"
                                                                  Stroke="{DynamicResource CsText3Brush}"
                                                                  StrokeThickness="1.7"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Margin="0,4,0,0"
                                                               HorizontalAlignment="Center"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource CsText3Brush}"
                                                               Text="{x:Static loc:Strings.History_NoPreview}" />
                                                </StackPanel>
                                                <Image Source="{Binding ThumbnailImage}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- 内容文字走历史字号/预览行数设置（P0-1/P1-7）：字号与行高按系数缩放，
                                                 MaxHeight = 行高 × 行数，保证截断永远发生在整行边界。
                                                 图片条目无正文行——缩略图就是内容主角（用户反馈 2026-08-26），
                                                 格式/尺寸/字节数降级为下方的小注记盒，不再冒充标题 -->
                                            <TextBlock MaxHeight="{DynamicResource CsHistoryPreviewMaxHeight}"
                                                       FontSize="{DynamicResource CsHistoryBodyFontSize}"
                                                       Foreground="{DynamicResource CsText2Brush}"
                                                       LineHeight="{DynamicResource CsHistoryBodyLineHeight}"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       Text="{Binding Preview, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding IsImage, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <!-- 远端来源用该设备的邻近色注记盒（按配对顺位）；本机条目不加盒，保持安静 -->
                                                <Border Margin="0,0,7,0"
                                                        Padding="7,1"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding OriginAccentIndex, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Background}"
                                                        BorderBrush="{Binding OriginAccentIndex, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Line}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="9"
                                                               Foreground="{Binding OriginAccentIndex, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Text}"
                                                               Text="{Binding OriginLabel}" />
                                                </Border>
                                                <!-- 形态注记盒（ADR 0003）：固定邻近色槽位，密码用藕紫不是红——
                                                     它是待找回的事实，不是警报；普通文本不加盒 -->
                                                <Border Margin="0,0,7,0"
                                                        Padding="7,1"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding FormatAccentIndex, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Background}"
                                                        BorderBrush="{Binding FormatAccentIndex, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Line}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Visibility="{Binding HasFormatBadge, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="9"
                                                               Foreground="{Binding FormatAccentIndex, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Text}"
                                                               Text="{Binding FormatLabel}" />
                                                </Border>
                                                <!-- 仅本机保留（ADR 0005 §5）：蓝牙备援等仅文本窗口内以 local_only
                                                     终止的本机图片——对端游标已越过、IP 恢复也不补传。中性灰注记盒，
                                                     事实陈述不是警报 -->
                                                <Border Margin="0,0,7,0"
                                                        Padding="7,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource CsSurface3Brush}"
                                                        BorderBrush="{DynamicResource CsLine2Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Visibility="{Binding ShowsLocalOnlyBadge, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="9"
                                                               Foreground="{DynamicResource CsText3Brush}"
                                                               Text="{x:Static loc:Strings.History_LocalOnlyBadge}" />
                                                </Border>
                                                <!-- 来源应用不可识别：与其它注记盒同形制的中性灰盒（accent 0 灰族），
                                                     事实陈述不是警报；可识别来源留在下方元信息行，保持安静 -->
                                                <Border Margin="0,0,7,0"
                                                        Padding="7,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource CsSurface3Brush}"
                                                        BorderBrush="{DynamicResource CsLine2Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Visibility="{Binding IsSourceKnown, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <TextBlock FontSize="9"
                                                               Foreground="{DynamicResource CsText3Brush}"
                                                               Text="{Binding Source, Mode=OneWay}" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontFamily="{StaticResource CsMono}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource CsText4Brush}"
                                                           Text="{Binding MetaLine, Mode=OneWay}" />
                                            </StackPanel>
                                            <!-- 图片元数据注记盒（用户反馈 2026-08-26）：编码/尺寸/字节数是
                                                 机器的声音（tokens §6 Mono），降级为安静灰小盒排在注记行之下，
                                                 永不担任标题；不可知的项直接缺省，不摆问号 -->
                                            <StackPanel Margin="0,6,0,0"
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                                <Border Margin="0,0,7,0"
                                                        Padding="7,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource CsSurface3Brush}"
                                                        BorderBrush="{DynamicResource CsLine2Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Visibility="{Binding HasImageFormatLabel, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontFamily="{StaticResource CsMono}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource CsText3Brush}"
                                                               Text="{Binding ImageFormatLabel, Mode=OneWay}" />
                                                </Border>
                                                <Border Margin="0,0,7,0"
                                                        Padding="7,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource CsSurface3Brush}"
                                                        BorderBrush="{DynamicResource CsLine2Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Visibility="{Binding HasImageDimensionsLabel, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontFamily="{StaticResource CsMono}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource CsText3Brush}"
                                                               Text="{Binding ImageDimensionsLabel, Mode=OneWay}" />
                                                </Border>
                                                <Border Padding="7,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource CsSurface3Brush}"
                                                        BorderBrush="{DynamicResource CsLine2Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Visibility="{Binding HasImageByteSizeLabel, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontFamily="{StaticResource CsMono}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource CsText3Brush}"
                                                               Text="{Binding ImageByteSizeLabel, Mode=OneWay}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态：三处衬线时刻之一（纲领 3.5），与 Android 同一词句。
                             未配对 = 首启引导：Serif 短句 + 幽灵「去配对」；已配对 = 静候，不催促。 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding History.Count}" Value="0" />
                                                <Condition Binding="{Binding ActiveQuery}" Value="" />
                                                <Condition Binding="{Binding IsFormatFilterActive}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconConduit}"
                                          Stroke="{DynamicResource CsText4Brush}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource CsSerif}"
                                       FontSize="18"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CsText2Brush}" />
                                        <Setter Property="Text" Value="{x:Static loc:Strings.History_Empty_Unpaired_Title}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPairedDevices}" Value="True">
                                                <Setter Property="Text" Value="{x:Static loc:Strings.History_Empty_Paired_Title}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
                                        <Setter Property="Text" Value="{x:Static loc:Strings.History_Empty_Unpaired_Body}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPairedDevices}" Value="True">
                                                <Setter Property="Text" Value="{x:Static loc:Strings.History_Empty_Paired_Body}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    Click="OnGoToConduitClicked"
                                    Content="{x:Static loc:Strings.History_Empty_GoPair}"
                                    FontSize="12.5"
                                    Padding="16,6">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource GhostFlowButton}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPairedDevices}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- 搜索无匹配：灰色事实一句，不占用衬线时刻 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding History.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- 后者胜出：真空列表让位给上面的衬线空状态 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding History.Count}" Value="0" />
                                                <Condition Binding="{Binding ActiveQuery}" Value="" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconSearch}"
                                          Stroke="{DynamicResource CsText4Brush}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource CsText3Brush}"
                                       TextAlignment="Center">
                                <Run Text="{x:Static loc:Strings.History_NoMatch_Prefix}" /><Run Text="{Binding ActiveQuery, Mode=OneWay}" /><Run Text="{x:Static loc:Strings.History_NoMatch_Suffix}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- 形态筛选无匹配（ADR 0003）：同样是灰色事实，不是衬线时刻 -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding History.Count}" Value="0" />
                                                <Condition Binding="{Binding ActiveQuery}" Value="" />
                                                <Condition Binding="{Binding IsFormatFilterActive}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource CsText3Brush}"
                                       Text="{x:Static loc:Strings.History_Empty_Filtered}"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="5"
                                Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <Button Command="{Binding CopySelectedCommand}" Content="{x:Static loc:Strings.History_CopySelected}" Style="{StaticResource GhostFlowButton}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding ViewSelectedCommand}"
                                Content="{x:Static loc:Strings.History_ViewDetail}"
                                Style="{StaticResource GhostQuietButton}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding DeleteSelectedCommand}"
                                Content="{x:Static loc:Strings.History_DeleteSelected}"
                                Style="{StaticResource GhostQuietButton}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding ClearCommand}"
                                Content="{x:Static loc:Strings.Common_ClearHistory}"
                                Style="{StaticResource GhostQuietButton}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding RefreshCommand}"
                                Content="{x:Static loc:Strings.Common_Refresh}"
                                Style="{StaticResource GhostQuietButton}" />
                    </StackPanel>
                </Grid>

                <!-- ———— 通路 ———— -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource PageFadeScroll}"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsChecked, ElementName=NavConduit, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="24,18,24,20">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static loc:Strings.Conduit_Title}" />
                        <TextBlock Style="{StaticResource PageSub}" Text="{x:Static loc:Strings.Conduit_Subtitle}" />

                        <!-- 四段管道：本机捕获 → 本机服务 → 网络 → 对端写入 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 段 1 · 本机捕获（随 暂停/私密 变灰；降级 = 赭色「需要你操作」+ 2.6s 脉动） -->
                            <ContentControl Margin="0,0,10,0" Style="{StaticResource SegCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconHistory}"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{DynamicResource CsFlowBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource CsText4Brush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPrivateMode}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource CsText4Brush}" />
                                                                </DataTrigger>
                                                                <!-- 降级排最后：故障比暂停/私密更需要被看见（赭色 = 需要行动，非错误红） -->
                                                                <DataTrigger Binding="{Binding CaptureFaulted}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource CsActBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Margin="7,0,0,0" Style="{StaticResource SegName}" Text="{x:Static loc:Strings.Conduit_Capture_Name}" />
                                    </StackPanel>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource SegStatus}" TargetType="TextBlock">
                                                <Setter Property="Text" Value="{x:Static loc:Strings.Conduit_Capture_Ready}" />
                                                <Setter Property="Foreground" Value="{DynamicResource CsFlowBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                        <Setter Property="Text" Value="{x:Static loc:Strings.Conduit_Status_Paused}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPrivateMode}" Value="True">
                                                        <Setter Property="Text" Value="{x:Static loc:Strings.Conduit_Status_Private}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CaptureFaulted}" Value="True">
                                                        <Setter Property="Text" Value="{x:Static loc:Strings.Conduit_Status_CaptureFaulted}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource CsActBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Grid Height="4" Margin="0,7,0,0">
                                        <!-- 脉动光环：仅「需要你操作」时出现——外扩 5px、渐隐、2.6s 循环（tokens §9 pulse），
                                             缓动逐位对齐 cubic-bezier(.16,1,.3,1)。
                                             减弱动效跟随系统（P1#13）：系统关掉「窗口内动画」（SPI_GETCLIENTAREAANIMATION）时
                                             光环不再播，静态 act 描边（下方填充层自带）独自承担「需要你操作」。 -->
                                        <Border CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CsActBrush}" />
                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding CaptureFaulted}" Value="True" />
                                                                <Condition Binding="{Binding Path=(sys:SystemParameters.ClientAreaAnimation)}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <MultiDataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="CapturePulse">
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin">
                                                                            <DiscreteThicknessKeyFrame KeyTime="0:0:0" Value="0" />
                                                                            <SplineThicknessKeyFrame KeySpline="0.16,1 0.3,1"
                                                                                                     KeyTime="0:0:1.3"
                                                                                                     Value="-5" />
                                                                            <SplineThicknessKeyFrame KeySpline="0.16,1 0.3,1"
                                                                                                     KeyTime="0:0:2.6"
                                                                                                     Value="0" />
                                                                        </ThicknessAnimationUsingKeyFrames>
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                                                                            <SplineDoubleKeyFrame KeySpline="0.16,1 0.3,1"
                                                                                                  KeyTime="0:0:1.3"
                                                                                                  Value="0" />
                                                                            <SplineDoubleKeyFrame KeySpline="0.16,1 0.3,1"
                                                                                                  KeyTime="0:0:2.6"
                                                                                                  Value="0.35" />
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </MultiDataTrigger.EnterActions>
                                                            <MultiDataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="CapturePulse" />
                                                            </MultiDataTrigger.ExitActions>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <!-- 轨道：常态 z−1 凹槽；「需要你操作」= act-bg 底（状态编码 §10） -->
                                        <Border CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CsSurfaceInBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CaptureFaulted}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CsActBgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <!-- 填充：就绪 = flow 满填充；暂停/私密 = 空；降级 = 空 + 1.5px act 描边 -->
                                            <Border HorizontalAlignment="Stretch" CornerRadius="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource CsFlowBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPrivateMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CaptureFaulted}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource CsActBrush}" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Border>
                                    </Grid>
                                    <Border Margin="0,7,0,0"
                                            Padding="0,7,0,0"
                                            BorderBrush="{DynamicResource CsLineBrush}"
                                            BorderThickness="0,1,0,0">
                                        <TextBlock Style="{StaticResource SegDetail}" Text="{x:Static loc:Strings.Conduit_Capture_Detail}" />
                                    </Border>
                                </StackPanel>
                            </ContentControl>

                            <!-- 段 2 · 本机服务（历史条数实时） -->
                            <ContentControl Grid.Column="1"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource SegCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconService}"
                                                      Stroke="{DynamicResource CsFlowBrush}"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Margin="7,0,0,0" Style="{StaticResource SegName}" Text="{x:Static loc:Strings.Conduit_Service_Name}" />
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource CsFlowBrush}" Style="{StaticResource SegStatus}">
                                        <Run Text="{x:Static loc:Strings.Conduit_Service_ReadyPrefix}" /><Run Text="{Binding History.Count, Mode=OneWay}" /><Run Text="{x:Static loc:Strings.Conduit_Service_ReadyInfix}" /><Run Text="{Binding OutboxPendingCount, Mode=OneWay}" />
                                    </TextBlock>
                                    <Border Height="4"
                                            Margin="0,7,0,0"
                                            Background="{DynamicResource CsSurfaceInBrush}"
                                            CornerRadius="2">
                                        <Border Background="{DynamicResource CsFlowBrush}" CornerRadius="2" />
                                    </Border>
                                    <Border Margin="0,7,0,0"
                                            Padding="0,7,0,0"
                                            BorderBrush="{DynamicResource CsLineBrush}"
                                            BorderThickness="0,1,0,0">
                                        <TextBlock Style="{StaticResource SegDetail}">
                                            <Run Text="{x:Static loc:Strings.Conduit_Service_DetailPrefix}" /><Run Text="{Binding LastAckText, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </ContentControl>

                            <!-- 段 3 · 网络（对端服务实时状态） -->
                            <ContentControl Grid.Column="2"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource SegCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconNetwork}"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{DynamicResource CsText4Brush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PeerOnline}" Value="True">
                                                                    <Setter Property="Stroke" Value="{DynamicResource CsFlowBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Margin="7,0,0,0" Style="{StaticResource SegName}" Text="{x:Static loc:Strings.Conduit_Network_Name}" />
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource CsFlowBrush}" Visibility="{Binding PeerOnline, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource SegStatus}" TargetType="TextBlock" />
                                        </TextBlock.Style>
                                        <Run Text="{x:Static loc:Strings.Conduit_Network_ReadyPrefix}" /><Run Text="{Binding PeerPort, Mode=OneWay}" /><Run Text="{x:Static loc:Strings.Conduit_Network_ReadyInfix}" /><Run Text="{Binding ConnectedDeviceCount, Mode=OneWay}" /><Run Text="{x:Static loc:Strings.Conduit_Network_ReadySuffix}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Static loc:Strings.Conduit_Network_Down}">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource SegStatus}" TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PeerOnline}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Height="4"
                                            Margin="0,7,0,0"
                                            Background="{DynamicResource CsSurfaceInBrush}"
                                            CornerRadius="2">
                                        <Border CornerRadius="2" Visibility="{Binding PeerOnline, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource CsFlowBrush}" />
                                    </Border>
                                    <Border Margin="0,7,0,0"
                                            Padding="0,7,0,0"
                                            BorderBrush="{DynamicResource CsLineBrush}"
                                            BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SegDetail}" Text="{Binding SyncStatus}" />
                                            <!-- 蓝牙备援一行：正在承载会话时用通行色，其余状态保持 detail 灰 -->
                                            <TextBlock Margin="0,4,0,0" Text="{Binding BluetoothStatus}">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource SegDetail}" TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BluetoothSessionActive}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource CsFlowBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ContentControl>

                            <!-- 段 4 · 对端写入（按已配对设备与自动应用推导） -->
                            <ContentControl Grid.Column="3" Style="{StaticResource SegCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconPhone}"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Stroke" Value="{DynamicResource CsFlowBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                                    <Setter Property="Stroke" Value="{DynamicResource CsText4Brush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Margin="7,0,0,0" Style="{StaticResource SegName}" Text="{x:Static loc:Strings.Conduit_Peer_Name}" />
                                    </StackPanel>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource SegStatus}" TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource CsFlowBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                        <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{x:Static loc:Strings.Conduit_Peer_PairedPrefix}" /><Run Text="{Binding Devices.Count, Mode=OneWay}" /><Run Text="{x:Static loc:Strings.Conduit_Peer_PairedSuffix}" />
                                    </TextBlock>
                                    <Border Height="4"
                                            Margin="0,7,0,0"
                                            Background="{DynamicResource CsSurfaceInBrush}"
                                            CornerRadius="2">
                                        <Border CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource CsFlowBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Border>
                                    <Border Margin="0,7,0,0"
                                            Padding="0,7,0,0"
                                            BorderBrush="{DynamicResource CsLineBrush}"
                                            BorderThickness="0,1,0,0">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource SegDetail}" TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{x:Static loc:Strings.Conduit_Peer_AutoApplyOn}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AutoApplyRemote}" Value="False">
                                                            <Setter Property="Text" Value="{x:Static loc:Strings.Conduit_Peer_AutoApplyOff}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </ContentControl>
                        </Grid>

                        <!-- 网络段 · 已配对设备（配对本质是接通网络段，设备清单挂在段下） -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="16,12,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="17" Height="17">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconDevices}"
                                                      Stroke="{DynamicResource CsText3Brush}"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CsText1Brush}"
                                                   Text="{x:Static loc:Strings.Conduit_Devices_Header}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Click="OnPairNewDeviceClicked"
                                            Style="{StaticResource PrimaryButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource IconPair}"
                                                          Stroke="{DynamicResource CsOnFlowBrush}"
                                                          StrokeThickness="1.9"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock VerticalAlignment="Center" Text="{x:Static loc:Strings.Pairing_Title}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 残留设备提醒：赭色是唯一允许打断用户的颜色（needs your action）。
                                     同名重复配对的旧档或长期未连接的设备在这里一键撤销并清空其待发积压 -->
                                <Border Margin="16,0,16,10"
                                        Padding="12,9"
                                        Background="{DynamicResource CsActBgBrush}"
                                        BorderBrush="{DynamicResource CsActLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Visibility="{Binding HasStaleDevices, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource CsActBrush}"
                                                   Text="{Binding StaleBannerText}"
                                                   TextWrapping="Wrap" />
                                        <Button Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding CleanupStaleDevicesCommand}"
                                                Content="{x:Static loc:Strings.Conduit_CleanupStale}"
                                                Style="{StaticResource GhostQuietButton}" />
                                    </Grid>
                                </Border>

                                <ListBox MaxHeight="220"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource DeviceItemContainer}"
                                         ItemsSource="{Binding Devices}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectedItem="{Binding SelectedDevice}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30"
                                                        Height="30"
                                                        VerticalAlignment="Center"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                    <!-- 邻近色按配对顺位（AccentIndex = dev-1..dev-5 循环）；已撤销退回灰——彩度是活跃度 -->
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{Binding AccentIndex, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Background}" />
                                                            <Setter Property="BorderBrush" Value="{Binding AccentIndex, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Line}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRevoked}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource CsSurface3Brush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource CsLine2Brush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Viewbox Width="15" Height="15">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="{StaticResource IconPhone}"
                                                                  StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Stroke" Value="{Binding AccentIndex, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Text}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRevoked}" Value="True">
                                                                                <Setter Property="Stroke" Value="{DynamicResource CsText4Brush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRevoked}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Normal" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <!-- 已撤销是灰的事实，不是红的错误 -->
                                                        <Border Margin="7,0,0,0"
                                                                Padding="7,1"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource CsSurface3Brush}"
                                                                BorderBrush="{DynamicResource CsLine2Brush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Visibility="{Binding IsRevoked, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock FontSize="9" Foreground="{DynamicResource CsText3Brush}" Text="{x:Static loc:Strings.Device_RevokedBadge}" />
                                                        </Border>
                                                        <!-- 残留标记：赭色提醒（同机重复配对或长期未连接），一键清理的对象 -->
                                                        <Border Margin="7,0,0,0"
                                                                Padding="7,1"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource CsActBgBrush}"
                                                                BorderBrush="{DynamicResource CsActLineBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock FontSize="9" Foreground="{DynamicResource CsActBrush}" Text="{Binding StaleReason}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Margin="0,1,0,0"
                                                               FontFamily="{StaticResource CsMono}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource CsText4Brush}">
                                                        <Run Text="{Binding Platform, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastSeenText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <!-- 设备色手动改（settings-roadmap P1#14）：五个邻近色点，点配对顺位默认色即恢复「跟随」。
                                                         已撤销的设备退回灰，不再有色可挑。 -->
                                                    <StackPanel Margin="0,5,0,0"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding IsRevoked, Converter={StaticResource InverseBoolToVisibility}}">
                                                        <TextBlock Margin="0,0,7,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource CsText3Brush}"
                                                                   Text="{x:Static loc:Strings.Device_AccentLabel}" />
                                                        <ItemsControl ItemsSource="{Binding AccentSwatches}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Width="16"
                                                                            Height="16"
                                                                            Margin="0,0,6,0"
                                                                            Command="{Binding DataContext.SetDeviceAccentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                            CommandParameter="{Binding}"
                                                                            Cursor="Hand"
                                                                            Focusable="False">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="Dot"
                                                                                        Background="{Binding Slot, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Text}"
                                                                                        BorderBrush="{Binding Slot, Converter={StaticResource DeviceAccentBrush}, ConverterParameter=Line}"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="8" />
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                        <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource CsText1Brush}" />
                                                                                        <Setter TargetName="Dot" Property="BorderThickness" Value="2" />
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <!-- 与 Android 通路行同一措辞：颜色来源是事实，不是错误 -->
                                                        <TextBlock Margin="2,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource CsText4Brush}"
                                                                   Text="{Binding AccentSourceText, Mode=OneWay}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 选中设备的动作：重命名 / 撤销 -->
                                <Border Padding="16,10"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Height="30"
                                                 FontFamily="{StaticResource CsMono}"
                                                 Style="{StaticResource InsetTextBox}"
                                                 Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Command="{Binding RenameDeviceCommand}"
                                                Content="{x:Static loc:Strings.Device_Rename}"
                                                Style="{StaticResource GhostQuietButton}" />
                                        <Button Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Command="{Binding RevokeDeviceCommand}"
                                                Content="{x:Static loc:Strings.Device_RevokeSelected}"
                                                Style="{StaticResource GhostDangerButton}" />
                                    </Grid>
                                </Border>

                                <Border Padding="16,10,16,12"
                                        Background="{DynamicResource CsSurface3Brush}"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0"
                                        CornerRadius="0,0,11,11">
                                    <TextBlock FontSize="10.5"
                                               Foreground="{DynamicResource CsText4Brush}"
                                               Text="{x:Static loc:Strings.Device_RevokeNote}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 网络段 · 连接（IA 迁移，settings-roadmap §四）：蓝牙备援、额外监听地址与
                             本机证书指纹改变「内容能不能到达对端」，按判据属通路，与配对同住网络段。 -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="16,12,16,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="17" Height="17">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconNetwork}"
                                                      Stroke="{DynamicResource CsText3Brush}"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CsText1Brush}"
                                                   Text="{x:Static loc:Strings.Conduit_Connection_Header}" />
                                    </StackPanel>
                                </Grid>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Conduit_Bluetooth_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Conduit_Bluetooth_Desc}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      VerticalAlignment="Top"
                                                      AutomationProperties.Name="{x:Static loc:Strings.Conduit_Bluetooth_Title}"
                                                      Click="OnSettingToggled"
                                                      IsChecked="{Binding BluetoothFallbackEnabled}"
                                                      Style="{StaticResource CharterToggle}" />
                                    </Grid>
                                </Border>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Conduit_ExtraBind_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Conduit_ExtraBind_Desc}" />
                                            <!-- 「重启后生效」用赭色说明，不用弹窗 -->
                                            <TextBlock Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource CsText4Brush}">
                                                <Run FontWeight="SemiBold" Foreground="{DynamicResource CsActBrush}" Text="{x:Static loc:Strings.Conduit_ExtraBind_RestartNote}" /><Run Text="{x:Static loc:Strings.Conduit_ExtraBind_CommaNote}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBox Grid.Column="1"
                                                 Width="220"
                                                 Height="30"
                                                 VerticalAlignment="Top"
                                                 FlowDirection="LeftToRight"
                                                 FontFamily="{StaticResource CsMono}"
                                                 FontSize="11.5"
                                                 LostFocus="OnSettingLostFocus"
                                                 Style="{StaticResource InsetTextBox}"
                                                 Text="{Binding ExtraBindAddresses, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>
                                <!-- 指纹只在配对仪式中被核对，住在配对所在的网络段旁 -->
                                <Border Padding="16,12,16,14"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Conduit_Fingerprint_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Conduit_Fingerprint_Desc}" />
                                            <!-- 指纹是机器文本：RTL 语言下仍保持 LTR 组序，逐组核对不换向 -->
                                            <TextBlock Margin="0,6,0,0"
                                                       FlowDirection="LeftToRight"
                                                       FontFamily="{StaticResource CsMono}"
                                                       FontSize="13"
                                                       LineHeight="24"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
                                                        <Setter Property="Text" Value="{Binding LocalFingerprint}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LocalFingerprint}" Value="">
                                                                <Setter Property="Foreground" Value="{DynamicResource CsText4Brush}" />
                                                                <Setter Property="Text" Value="{x:Static loc:Strings.Conduit_Fingerprint_Unavailable}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Command="{Binding CopyFingerprintCommand}"
                                                Content="{x:Static loc:Strings.Common_Copy}"
                                                Style="{StaticResource GhostQuietButton}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 特权直读 · PC 侧 adb 协助（任务 1）：帮已配对手机开启后台直读。绝不静默——
                             先解释、经明确同意后才发第一条 adb 命令；首次 USB 调试的 RSA 授权仍需在手机上
                             手动确认（威胁模型：no silent adb）。特权直读是 Android 后台读取阶梯里质量最高的一档。 -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="16,12,16,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="17" Height="17">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource IconDevices}"
                                                      Stroke="{DynamicResource CsText3Brush}"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CsText1Brush}"
                                                   Text="{x:Static loc:Strings.Conduit_Privileged_Header}" />
                                    </StackPanel>
                                </Grid>

                                <Border Padding="16,0,16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <TextBlock Margin="0,12,0,0"
                                               Style="{StaticResource RowDesc}"
                                               Text="{x:Static loc:Strings.Conduit_Privileged_Desc}" />
                                </Border>

                                <!-- 同意门槛：未同意前只解释，一条 adb 都不发 -->
                                <Border Padding="16,4,16,14"
                                        Visibility="{Binding PrivilegedAdbConsent, Converter={StaticResource InverseBoolToVisibility}}">
                                    <StackPanel>
                                        <Border Padding="12,10"
                                                Background="{DynamicResource CsActBgBrush}"
                                                BorderBrush="{DynamicResource CsActLineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource CsActBrush}"
                                                       Text="{x:Static loc:Strings.Conduit_Privileged_ConsentBody}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                        <Button Margin="0,12,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding GrantPrivilegedConsentCommand}"
                                                Content="{x:Static loc:Strings.Conduit_Privileged_ConsentAllow}"
                                                Style="{StaticResource GhostFlowButton}" />
                                    </StackPanel>
                                </Border>

                                <!-- 已同意：检测手机 + 一键启动 + 撤销；状态与结果都如实陈述 -->
                                <Border Padding="16,4,16,14"
                                        Visibility="{Binding PrivilegedAdbConsent, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource RowName}" TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding PrivilegedStatus}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrivilegedStatus}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- adb 位置是机器文本：Mono，RTL 下钉回 LTR -->
                                        <TextBlock Margin="0,4,0,0"
                                                   FlowDirection="LeftToRight"
                                                   FontFamily="{StaticResource CsMono}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource CsText4Brush}"
                                                   Text="{Binding PrivilegedAdbLocation}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                            <Button Command="{Binding DetectPhoneCommand}"
                                                    Content="{x:Static loc:Strings.Conduit_Privileged_Detect}"
                                                    Style="{StaticResource GhostQuietButton}" />
                                            <Button Margin="8,0,0,0"
                                                    Command="{Binding StartPrivilegedHostCommand}"
                                                    Content="{x:Static loc:Strings.Conduit_Privileged_Start}"
                                                    Style="{StaticResource GhostFlowButton}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Setter Property="Foreground" Value="{DynamicResource CsFlowBrush}" />
                                                    <Setter Property="Text" Value="{Binding PrivilegedActionResult}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PrivilegedActionResult}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- ―― 无线配对（Android 11+ 无线调试）：USB 的替代通路，缺省折叠。
                                             出示二维码期间每两秒查一次 adb mDNS——这句写在等待文案里，
                                             轮询限时两分钟、随时可停，绝无背后动作 ―― -->
                                        <Border Margin="0,14,0,0"
                                                Padding="0,12,0,0"
                                                BorderBrush="{DynamicResource CsLineBrush}"
                                                BorderThickness="0,1,0,0">
                                            <StackPanel>
                                                <ToggleButton Content="{x:Static loc:Strings.Conduit_Wireless_SectionTitle}"
                                                              IsChecked="{Binding WirelessPanelOpen}"
                                                              Style="{StaticResource FoldToggle}" />
                                                <StackPanel Visibility="{Binding WirelessPanelOpen, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Margin="0,8,0,0"
                                                               Style="{StaticResource RowDesc}"
                                                               Text="{x:Static loc:Strings.Conduit_Wireless_SectionDesc}" />

                                                    <!-- 路 A：二维码（Android Studio 同款） -->
                                                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                                        <Button Command="{Binding ShowWirelessQrCommand}"
                                                                Content="{x:Static loc:Strings.Conduit_Wireless_ShowQr}"
                                                                Style="{StaticResource GhostFlowButton}" />
                                                        <Button Margin="8,0,0,0"
                                                                Command="{Binding StopWirelessQrCommand}"
                                                                Content="{x:Static loc:Strings.Conduit_Wireless_StopQr}"
                                                                Style="{StaticResource GhostQuietButton}">
                                                            <Button.Visibility>
                                                                <Binding Converter="{StaticResource StringNotEmptyToVisibility}" Path="WirelessQrText" />
                                                            </Button.Visibility>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- 二维码本体：静区必须纯白（配对窗同规），模块按 DPI 取整（代码里栅格化） -->
                                                    <StackPanel Visibility="{Binding WirelessQrText, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                        <Border Margin="0,12,0,0"
                                                                Padding="10"
                                                                HorizontalAlignment="Left"
                                                                Background="{DynamicResource CsQrQuietBrush}"
                                                                BorderBrush="{DynamicResource CsLineBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                            <Image x:Name="WirelessQrImage"
                                                                   Width="200"
                                                                   Height="200"
                                                                   AutomationProperties.Name="{x:Static loc:Strings.Conduit_Wireless_QrInstruction}"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                   SnapsToDevicePixels="True" />
                                                        </Border>
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Style="{StaticResource RowDesc}"
                                                                   Text="{x:Static loc:Strings.Conduit_Wireless_QrInstruction}" />
                                                    </StackPanel>

                                                    <!-- 状态行：一句人话陈述无线流程停在哪 -->
                                                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style BasedOn="{StaticResource RowName}" TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding WirelessStatus}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding WirelessStatus}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- 失败后的下一步提示 = 需要你操作（赭色着色盒），不是错误 -->
                                                    <Border Margin="0,10,0,0"
                                                            Padding="12,10"
                                                            Background="{DynamicResource CsActBgBrush}"
                                                            BorderBrush="{DynamicResource CsActLineBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Visibility="{Binding WirelessHint, Converter={StaticResource StringNotEmptyToVisibility}}">
                                                        <TextBlock FontSize="11"
                                                                   Foreground="{DynamicResource CsActBrush}"
                                                                   Text="{Binding WirelessHint}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>

                                                    <!-- 路 B：配对码（无线调试 → 使用配对码配对设备） -->
                                                    <TextBlock Margin="0,16,0,0"
                                                               Style="{StaticResource RowName}"
                                                               Text="{x:Static loc:Strings.Conduit_Wireless_ManualTitle}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource RowDesc}"
                                                               Text="{x:Static loc:Strings.Conduit_Wireless_ManualDesc}" />
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- IP:端口与配对码是机器文本：Mono，RTL 下钉回 LTR -->
                                                        <TextBox Height="30"
                                                                 AutomationProperties.Name="{x:Static loc:Strings.Conduit_Wireless_PairEndpointLabel}"
                                                                 FlowDirection="LeftToRight"
                                                                 FontFamily="{StaticResource CsMono}"
                                                                 FontSize="11.5"
                                                                 Style="{StaticResource InsetTextBox}"
                                                                 Text="{Binding WirelessPairEndpointText, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Column="1"
                                                                 Width="76"
                                                                 Height="30"
                                                                 Margin="8,0,0,0"
                                                                 AutomationProperties.Name="{x:Static loc:Strings.Conduit_Wireless_PairCodeLabel}"
                                                                 FlowDirection="LeftToRight"
                                                                 FontFamily="{StaticResource CsMono}"
                                                                 FontSize="11.5"
                                                                 MaxLength="6"
                                                                 Style="{StaticResource InsetTextBox}"
                                                                 Text="{Binding WirelessPairCodeText, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextAlignment="Center" />
                                                        <Button Grid.Column="2"
                                                                Margin="8,0,0,0"
                                                                Command="{Binding PairWirelessManuallyCommand}"
                                                                Content="{x:Static loc:Strings.Conduit_Wireless_PairButton}"
                                                                Style="{StaticResource GhostFlowButton}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource CsText4Brush}"
                                                               Text="{x:Static loc:Strings.Conduit_Wireless_PairEndpointLabel}"
                                                               TextWrapping="Wrap" />

                                                    <!-- 连接：配对完成后（或此前已配对过）adb connect -->
                                                    <TextBlock Margin="0,14,0,0"
                                                               Style="{StaticResource RowName}"
                                                               Text="{x:Static loc:Strings.Conduit_Wireless_ConnectTitle}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource RowDesc}"
                                                               Text="{x:Static loc:Strings.Conduit_Wireless_ConnectDesc}" />
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Height="30"
                                                                 AutomationProperties.Name="{x:Static loc:Strings.Conduit_Wireless_ConnectEndpointLabel}"
                                                                 FlowDirection="LeftToRight"
                                                                 FontFamily="{StaticResource CsMono}"
                                                                 FontSize="11.5"
                                                                 Style="{StaticResource InsetTextBox}"
                                                                 Text="{Binding WirelessConnectEndpointText, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button Grid.Column="1"
                                                                Margin="8,0,0,0"
                                                                Command="{Binding ConnectWirelessCommand}"
                                                                Content="{x:Static loc:Strings.Conduit_Wireless_ConnectButton}"
                                                                Style="{StaticResource GhostFlowButton}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource CsText4Brush}"
                                                               Text="{x:Static loc:Strings.Conduit_Wireless_ConnectEndpointLabel}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 首次 USB 调试的 RSA「允许调试」授权始终要在手机上手动点，adb 代替不了 -->
                                        <TextBlock Margin="0,12,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource CsText4Brush}"
                                                   Text="{x:Static loc:Strings.Conduit_Privileged_ManualNote}"
                                                   TextWrapping="Wrap" />
                                        <Button Margin="0,10,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding RevokePrivilegedConsentCommand}"
                                                Content="{x:Static loc:Strings.Conduit_Privileged_ConsentRevoke}"
                                                Style="{StaticResource GhostQuietButton}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ———— 偏好 ———— -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource PageFadeScroll}"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsChecked, ElementName=NavPrefs, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="24,18,24,20">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static loc:Strings.Prefs_Title}" />
                        <TextBlock Style="{StaticResource PageSub}" Text="{x:Static loc:Strings.Prefs_Subtitle}" />

                        <!-- 显示（settings-roadmap P0-1 / P1-7 / P1-6）：只缩放内容文字，chrome 不动；外观只选日/夜字典 -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource GroupHeader}" Text="{x:Static loc:Strings.Prefs_Group_Display}" />
                                <Grid Margin="16,9,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_FontScale_Title}" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_FontScale_Desc}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Orientation="Horizontal">
                                        <RadioButton Click="OnSettingToggled"
                                                     Content="{x:Static loc:Strings.Prefs_FontScale_Small}"
                                                     GroupName="PrefsFontScale"
                                                     IsChecked="{Binding HistoryFontScaleKey, Converter={StaticResource StringMatch}, ConverterParameter=small}"
                                                     Style="{StaticResource FilterChip}" />
                                        <RadioButton Click="OnSettingToggled"
                                                     Content="{x:Static loc:Strings.Prefs_FontScale_Standard}"
                                                     GroupName="PrefsFontScale"
                                                     IsChecked="{Binding HistoryFontScaleKey, Converter={StaticResource StringMatch}, ConverterParameter=standard}"
                                                     Style="{StaticResource FilterChip}" />
                                        <RadioButton Click="OnSettingToggled"
                                                     Content="{x:Static loc:Strings.Prefs_FontScale_Large}"
                                                     GroupName="PrefsFontScale"
                                                     IsChecked="{Binding HistoryFontScaleKey, Converter={StaticResource StringMatch}, ConverterParameter=large}"
                                                     Style="{StaticResource FilterChip}" />
                                    </StackPanel>
                                </Grid>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_PreviewLines_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_PreviewLines_Desc}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Top"
                                                    Orientation="Horizontal">
                                            <RadioButton Click="OnSettingToggled"
                                                         Content="{x:Static loc:Strings.Prefs_PreviewLines_Two}"
                                                         GroupName="PrefsPreviewLines"
                                                         IsChecked="{Binding PreviewLinesKey, Converter={StaticResource StringMatch}, ConverterParameter=2}"
                                                         Style="{StaticResource FilterChip}" />
                                            <RadioButton Click="OnSettingToggled"
                                                         Content="{x:Static loc:Strings.Prefs_PreviewLines_Four}"
                                                         GroupName="PrefsPreviewLines"
                                                         IsChecked="{Binding PreviewLinesKey, Converter={StaticResource StringMatch}, ConverterParameter=4}"
                                                         Style="{StaticResource FilterChip}" />
                                            <RadioButton Click="OnSettingToggled"
                                                         Content="{x:Static loc:Strings.Prefs_PreviewLines_Six}"
                                                         GroupName="PrefsPreviewLines"
                                                         IsChecked="{Binding PreviewLinesKey, Converter={StaticResource StringMatch}, ConverterParameter=6}"
                                                         Style="{StaticResource FilterChip}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- 外观（settings-roadmap P1-6）：只在既有日/夜双字典间选择，绝无自定义配色 -->
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Theme_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Theme_Desc}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Top"
                                                    Orientation="Horizontal">
                                            <RadioButton Click="OnSettingToggled"
                                                         Content="{x:Static loc:Strings.Common_FollowSystem}"
                                                         GroupName="PrefsThemeMode"
                                                         IsChecked="{Binding ThemeModeKey, Converter={StaticResource StringMatch}, ConverterParameter=system}"
                                                         Style="{StaticResource FilterChip}" />
                                            <RadioButton Click="OnSettingToggled"
                                                         Content="{x:Static loc:Strings.Prefs_Theme_Day}"
                                                         GroupName="PrefsThemeMode"
                                                         IsChecked="{Binding ThemeModeKey, Converter={StaticResource StringMatch}, ConverterParameter=day}"
                                                         Style="{StaticResource FilterChip}" />
                                            <RadioButton Click="OnSettingToggled"
                                                         Content="{x:Static loc:Strings.Prefs_Theme_Night}"
                                                         GroupName="PrefsThemeMode"
                                                         IsChecked="{Binding ThemeModeKey, Converter={StaticResource StringMatch}, ConverterParameter=night}"
                                                         Style="{StaticResource FilterChip}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- 语言（settings-roadmap P1#16）：19 种语言 + 跟随系统，chip 放不下改用下拉；
                                     语言名恒以各自母语显示（不翻译）；更换后重启生效 -->
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Language_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}"><Run Text="{x:Static loc:Strings.Prefs_Language_Desc}" /><Run FontWeight="SemiBold"
     Foreground="{DynamicResource CsActBrush}"
     Text="{x:Static loc:Strings.Prefs_Language_RestartNote}" /></TextBlock>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  MinWidth="176"
                                                  VerticalAlignment="Top"
                                                  AutomationProperties.Name="{x:Static loc:Strings.Prefs_Language_Title}"
                                                  DisplayMemberPath="DisplayName"
                                                  ItemsSource="{Binding LanguageOptions, Mode=OneTime}"
                                                  SelectedValue="{Binding LanguageKey}"
                                                  SelectedValuePath="Key"
                                                  SelectionChanged="OnLanguageSelectionChanged"
                                                  Style="{StaticResource InsetComboBox}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 捕获 -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource GroupHeader}" Text="{x:Static loc:Strings.Prefs_Group_Capture}" />
                                <Grid Margin="16,9,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Common_PauseCapture}" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Capture_Pause_Desc}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  VerticalAlignment="Top"
                                                  AutomationProperties.Name="{x:Static loc:Strings.Common_PauseCapture}"
                                                  Click="OnSettingToggled"
                                                  IsChecked="{Binding IsPaused}"
                                                  Style="{StaticResource CharterToggle}" />
                                </Grid>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Common_PrivateMode}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Capture_Private_Desc}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      VerticalAlignment="Top"
                                                      AutomationProperties.Name="{x:Static loc:Strings.Common_PrivateMode}"
                                                      Click="OnSettingToggled"
                                                      IsChecked="{Binding IsPrivateMode}"
                                                      Style="{StaticResource CharterToggle}" />
                                    </Grid>
                                </Border>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Capture_Blocked_Title}" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Capture_Blocked_Desc}" />
                                        <TextBox Height="88"
                                                 Margin="0,8,0,0"
                                                 AcceptsReturn="True"
                                                 FontFamily="{StaticResource CsMono}"
                                                 FontSize="11.5"
                                                 LostFocus="OnSettingLostFocus"
                                                 Style="{StaticResource InsetTextBox}"
                                                 Text="{Binding BlockedProcesses, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 同步 -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource GroupHeader}" Text="{x:Static loc:Strings.Prefs_Group_Sync}" />
                                <Grid Margin="16,9,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Sync_AutoApply_Title}" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Sync_AutoApply_Desc}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  VerticalAlignment="Top"
                                                  AutomationProperties.Name="{x:Static loc:Strings.Prefs_Sync_AutoApply_Title}"
                                                  Click="OnSettingToggled"
                                                  IsChecked="{Binding AutoApplyRemote}"
                                                  Style="{StaticResource CharterToggle}" />
                                </Grid>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Sync_ImageSync_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Sync_ImageSync_Desc}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      VerticalAlignment="Top"
                                                      AutomationProperties.Name="{x:Static loc:Strings.Prefs_Sync_ImageSync_Title}"
                                                      Click="OnSettingToggled"
                                                      IsChecked="{Binding ImageSyncEnabled}"
                                                      Style="{StaticResource CharterToggle}" />
                                    </Grid>
                                </Border>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Sync_AutoApplyImages_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Sync_AutoApplyImages_Desc}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      VerticalAlignment="Top"
                                                      AutomationProperties.Name="{x:Static loc:Strings.Prefs_Sync_AutoApplyImages_Title}"
                                                      Click="OnSettingToggled"
                                                      IsChecked="{Binding AutoApplyImages}"
                                                      Style="{StaticResource CharterToggle}" />
                                    </Grid>
                                </Border>
                                <!-- IA 迁移过渡（settings-roadmap §4.2）：连通性配置已迁往通路网络段，
                                     此链接行保留一个发布版本后删除。 -->
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Moved_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Moved_Desc}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Click="OnGoToConduitClicked"
                                                Content="{x:Static loc:Strings.Prefs_Moved_GoToConduit}"
                                                Style="{StaticResource GhostQuietButton}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 存留 -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource GroupHeader}" Text="{x:Static loc:Strings.Prefs_Group_Retention}" />
                                <Grid Margin="16,9,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Retention_Days_Title}" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Retention_Days_Desc}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource CsSurfaceInBrush}"
                                            BorderBrush="{DynamicResource CsLineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="OnRetentionMinusClicked" Content="−" Style="{StaticResource StepButton}" />
                                            <Border Background="{DynamicResource CsSurfaceBrush}"
                                                    BorderBrush="{DynamicResource CsLineBrush}"
                                                    BorderThickness="1,0">
                                                <TextBlock MinWidth="42"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource CsMono}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource CsText1Brush}"
                                                           Text="{Binding RetentionDays}"
                                                           TextAlignment="Center" />
                                            </Border>
                                            <Button Click="OnRetentionPlusClicked" Content="＋" Style="{StaticResource StepButton}" />
                                            <TextBlock Margin="7,0,9,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource CsText4Brush}"
                                                       Text="{x:Static loc:Strings.Prefs_Retention_DaysUnit}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- 保留条数上限（P1-15）：一直存在的 2000 条清理上限从硬编码变为可调 -->
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Retention_Entries_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Retention_Entries_Desc}" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource CsSurfaceInBrush}"
                                                BorderBrush="{DynamicResource CsLineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Click="OnMaxEntriesMinusClicked" Content="−" Style="{StaticResource StepButton}" />
                                                <Border Background="{DynamicResource CsSurfaceBrush}"
                                                        BorderBrush="{DynamicResource CsLineBrush}"
                                                        BorderThickness="1,0">
                                                    <TextBlock MinWidth="42"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource CsMono}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource CsText1Brush}"
                                                               Text="{Binding RetentionMaxEntries}"
                                                               TextAlignment="Center" />
                                                </Border>
                                                <Button Click="OnMaxEntriesPlusClicked" Content="＋" Style="{StaticResource StepButton}" />
                                                <TextBlock Margin="7,0,9,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource CsText4Brush}"
                                                           Text="{x:Static loc:Strings.Prefs_Retention_EntriesUnit}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 运行（settings-roadmap P0-3 / P1-9）：应用怎么跑，不碰内容 -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource GroupHeader}" Text="{x:Static loc:Strings.Prefs_Group_Startup}" />
                                <Grid Margin="16,9,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Startup_Launch_Title}" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Startup_Launch_Desc}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  VerticalAlignment="Top"
                                                  AutomationProperties.Name="{x:Static loc:Strings.Prefs_Startup_Launch_Title}"
                                                  Click="OnSettingToggled"
                                                  IsChecked="{Binding LaunchAtStartup}"
                                                  Style="{StaticResource CharterToggle}" />
                                </Grid>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Startup_Hotkey_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Startup_Hotkey_Desc}" />
                                            <!-- 注册结果如实陈述：被占用 = 赭色「需要你操作」，生效 = 安静灰 -->
                                            <TextBlock Margin="0,5,0,0"
                                                       FontSize="10.5"
                                                       Text="{Binding FlyoutHotkeyStatus}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource CsText4Brush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FlyoutHotkeyStatus}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FlyoutHotkeyConflict}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource CsActBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBox Grid.Column="1"
                                                 Width="150"
                                                 Height="30"
                                                 VerticalAlignment="Top"
                                                 AutomationProperties.Name="{x:Static loc:Strings.Prefs_Startup_Hotkey_Title}"
                                                 FontFamily="{StaticResource CsMono}"
                                                 FontSize="11.5"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="False"
                                                 IsUndoEnabled="False"
                                                 PreviewKeyDown="OnHotkeyBoxPreviewKeyDown"
                                                 Style="{StaticResource InsetTextBox}"
                                                 Text="{Binding FlyoutHotkey, Mode=OneWay}"
                                                 TextAlignment="Center" />
                                    </Grid>
                                </Border>
                                <!-- 暂停同步快捷键（P1-9 另一半）：同一套录入与如实陈述 -->
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_Startup_PauseHotkey_Title}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Startup_PauseHotkey_Desc}" />
                                            <!-- 注册结果如实陈述：被占用 = 赭色「需要你操作」，生效 = 安静灰 -->
                                            <TextBlock Margin="0,5,0,0"
                                                       FontSize="10.5"
                                                       Text="{Binding PauseHotkeyStatus}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource CsText4Brush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PauseHotkeyStatus}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PauseHotkeyConflict}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource CsActBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBox Grid.Column="1"
                                                 Width="150"
                                                 Height="30"
                                                 VerticalAlignment="Top"
                                                 AutomationProperties.Name="{x:Static loc:Strings.Prefs_Startup_PauseHotkey_Title}"
                                                 FontFamily="{StaticResource CsMono}"
                                                 FontSize="11.5"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="False"
                                                 IsUndoEnabled="False"
                                                 PreviewKeyDown="OnPauseHotkeyBoxPreviewKeyDown"
                                                 Style="{StaticResource InsetTextBox}"
                                                 Text="{Binding PauseHotkey, Mode=OneWay}"
                                                 TextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 数据 -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource GroupHeader}" Text="{x:Static loc:Strings.Prefs_Group_Data}" />
                                <Grid Margin="16,9,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Common_ExportHistory}" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Data_Export_Desc}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Command="{Binding ExportHistoryCommand}"
                                            Content="{x:Static loc:Strings.Common_ExportHistory}"
                                            Style="{StaticResource GhostQuietButton}" />
                                </Grid>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Common_ImportHistory}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Data_Import_Desc}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Command="{Binding ImportHistoryCommand}"
                                                Content="{x:Static loc:Strings.Common_ImportHistory}"
                                                Style="{StaticResource GhostQuietButton}" />
                                    </Grid>
                                </Border>
                                <!-- 清空历史（P0-5）：两步确认 + 明示先导出；本地删除语义，不远程撤回 -->
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Common_ClearHistory}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_Data_Clear_Desc}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Command="{Binding ClearCommand}"
                                                Content="{x:Static loc:Strings.Common_ClearHistory}"
                                                Style="{StaticResource GhostDangerButton}" />
                                    </Grid>
                                </Border>
                                <Border Padding="16,10"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <TextBlock FontFamily="{StaticResource CsMono}"
                                               FontSize="11"
                                               Foreground="{DynamicResource CsText3Brush}"
                                               Text="{Binding HistoryTransferStatus}"
                                               TextWrapping="Wrap" />
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HistoryTransferStatus}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <!-- 帮助：重新查看首开引导（对齐 Android 偏好 · 帮助）——重看不改任何设置与配对 -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource GroupHeader}" Text="{x:Static loc:Strings.Prefs_Group_Help}" />
                                <Grid Margin="16,9,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_ReplayOnboarding}" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_ReplayOnboarding_Desc}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Click="OnReplayOnboardingClicked"
                                            Content="{x:Static loc:Strings.Prefs_ReplayOnboarding}"
                                            Style="{StaticResource GhostQuietButton}" />
                                </Grid>
                            </StackPanel>
                        </ContentControl>

                        <!-- 关于：本机版本 + 从 GitHub latest 检查 / 下载便携 ZIP -->
                        <ContentControl Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource GroupHeader}" Text="{x:Static loc:Strings.Prefs_Group_About}" />
                                <Grid Margin="16,9,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_CurrentVersion}" />
                                        <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_CurrentVersion_Desc}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Top"
                                               FontFamily="{StaticResource CsMono}"
                                               FontSize="13"
                                               Foreground="{DynamicResource CsText2Brush}"
                                               Text="{Binding AppVersion}" />
                                </Grid>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource RowName}" Text="{x:Static loc:Strings.Prefs_CheckUpdate}" />
                                            <TextBlock Style="{StaticResource RowDesc}" Text="{x:Static loc:Strings.Prefs_CheckUpdate_Desc}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Command="{Binding CheckForUpdatesCommand}"
                                                Content="{x:Static loc:Strings.Prefs_CheckUpdate}"
                                                Style="{StaticResource GhostQuietButton}" />
                                    </Grid>
                                </Border>
                                <Border Padding="16,12"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding DownloadUpdateCommand}"
                                            Content="{x:Static loc:Strings.Prefs_Update_Download}"
                                            Style="{StaticResource GhostQuietButton}" />
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Padding="16,10"
                                        BorderBrush="{DynamicResource CsLineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <TextBlock FontFamily="{StaticResource CsMono}"
                                               FontSize="11"
                                               Foreground="{DynamicResource CsText3Brush}"
                                               Text="{Binding UpdateStatus}"
                                               TextWrapping="Wrap" />
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateStatus}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
    </Border>
</Window>
