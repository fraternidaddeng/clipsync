<Window x:Class="ClipSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:ClipSync.App"
        Title="{x:Static app:Strings.AppTitle}"
        Width="980"
        Height="640"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <app:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <app:FilePathToImageConverter x:Key="FilePathToImage" />
    </Window.Resources>
    <Grid Background="#F7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="24,18" Background="White" BorderBrush="#DDE1E7" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{x:Static app:Strings.AppTitle}" />
                    <TextBlock Margin="0,4,0,0" Foreground="#5E6672" Text="{x:Static app:Strings.HistorySubtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Margin="0,0,20,0" Click="OnCaptureSettingToggled" Content="{x:Static app:Strings.PauseCapture}" IsChecked="{Binding IsPaused}" />
                    <CheckBox Click="OnCaptureSettingToggled" Content="{x:Static app:Strings.PrivateMode}" IsChecked="{Binding IsPrivateMode}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="430" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Command="{Binding SearchCommand}" Content="{x:Static app:Strings.Search}" />
                    <TextBox Height="34" Padding="8,5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding History}"
                         SelectedItem="{Binding SelectedItem}"
                         BorderBrush="#CBD1D9"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnHistoryItemDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8" Width="520">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="56"
                                        Height="56"
                                        Margin="0,0,12,0"
                                        CornerRadius="4"
                                        ClipToBounds="True"
                                        Background="#EEF1F5"
                                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                    <Image Stretch="UniformToFill"
                                           Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToImage}}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock MaxHeight="56"
                                               Text="{Binding Preview}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsImage, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBlock FontSize="13"
                                               Foreground="#3D4450"
                                               Text="{Binding Preview}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Margin="0,6,0,0" Foreground="#6D7580" FontSize="12">
                                        <Run Text="{Binding Source}" /><Run Text="  " /><Run Text="{Binding CreatedAt}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="4" Orientation="Horizontal">
                    <Button Width="90" Command="{Binding CopySelectedCommand}" Content="{x:Static app:Strings.Copy}" />
                    <Button Width="90" Margin="8,0,0,0" Command="{Binding ViewSelectedCommand}" Content="{x:Static app:Strings.View}" />
                    <Button Width="90" Margin="8,0,0,0" Command="{Binding DeleteSelectedCommand}" Content="{x:Static app:Strings.Delete}" />
                    <Button Width="90" Margin="8,0,0,0" Command="{Binding ClearCommand}" Content="{x:Static app:Strings.ClearAll}" />
                    <Button Width="90" Margin="8,0,0,0" Command="{Binding RefreshCommand}" Content="{x:Static app:Strings.Refresh}" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="2" Padding="18" Background="White" BorderBrush="#CBD1D9" BorderThickness="1" CornerRadius="6">
                <ScrollViewer Margin="-6,0" Padding="6,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{x:Static app:Strings.CaptureSettings}" />
                    <TextBlock Margin="0,18,0,6" Text="{x:Static app:Strings.RetentionDays}" />
                    <TextBox Padding="8,5" Text="{Binding RetentionDays}" />
                    <TextBlock Margin="0,18,0,6" Text="{x:Static app:Strings.BlockedProcesses}" />
                    <TextBox Height="120"
                             Padding="8"
                             AcceptsReturn="True"
                             Text="{Binding BlockedProcesses}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <Separator Margin="0,22,0,16" />
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{x:Static app:Strings.Sync}" />
                    <CheckBox Margin="0,14,0,0"
                              Content="{x:Static app:Strings.AutoApplyRemote}"
                              IsChecked="{Binding AutoApplyRemote}" />
                    <CheckBox Margin="0,10,0,0"
                              Content="{x:Static app:Strings.ImageSync}"
                              IsChecked="{Binding ImageSyncEnabled}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#6D7580"
                               Text="{x:Static app:Strings.ImageSyncHint}"
                               TextWrapping="Wrap" />
                    <CheckBox Margin="0,10,0,0"
                              Content="{x:Static app:Strings.AutoApplyImages}"
                              IsChecked="{Binding AutoApplyImages}" />
                    <TextBlock Margin="0,14,0,6" Text="{x:Static app:Strings.ExtraBindAddresses}" />
                    <TextBox Padding="8,5" Text="{Binding ExtraBindAddresses}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="#6D7580"
                               Text="{x:Static app:Strings.AddressRestartHint}"
                               TextWrapping="Wrap" />
                    <Button Height="34" Margin="0,18,0,0" Command="{Binding SaveSettingsCommand}" Content="{x:Static app:Strings.SaveSettings}" />
                    <Button Height="34" Margin="0,12,0,0" Command="{Binding ExportHistoryCommand}" Content="{x:Static app:Strings.ExportHistory}" />
                    <Button Height="34" Margin="0,12,0,0" Command="{Binding ImportHistoryCommand}" Content="{x:Static app:Strings.ImportHistory}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="#6D7580"
                               Text="{x:Static app:Strings.ExportPlaintextWarning}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#3B424C"
                               Text="{Binding ExportStatus}"
                               TextWrapping="Wrap" />
                    <Separator Margin="0,22,0,16" />
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{x:Static app:Strings.PairedDevices}" />
                    <Button Height="32" Margin="0,12,0,0" Click="OnPairNewDeviceClicked" Content="{x:Static app:Strings.PairNewDevice}" />
                    <ListBox MaxHeight="180"
                             Margin="0,12,0,0"
                             BorderBrush="#CBD1D9"
                             BorderThickness="1"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="#6D7580">
                                        <Run Text="{Binding Platform, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastSeenText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="#A4262C" Text="{Binding StateText}" Visibility="{Binding IsRevoked, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,12,0,4" FontSize="12" Text="{x:Static app:Strings.RenameSelectedDevice}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Width="70" Margin="8,0,0,0" Command="{Binding RenameDeviceCommand}" Content="{x:Static app:Strings.Rename}" />
                        <TextBox Padding="6,4" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Button Height="30"
                            Margin="0,10,0,0"
                            Command="{Binding RevokeDeviceCommand}"
                            Content="{x:Static app:Strings.RevokeSelectedDevice}"
                            Foreground="#A4262C" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="#6D7580"
                               Text="{x:Static app:Strings.RevokeWarning}"
                               TextWrapping="Wrap" />
                    <Separator Margin="0,22,0,18" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,9,0" Fill="#27844F" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Static app:Strings.LocalCaptureRunning}" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="#6D7580"
                               Text="{Binding SyncStatus}"
                               TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
