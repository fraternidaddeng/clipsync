<!--
    Charter window chrome: caption-button styles and glyphs shared by every
    window (main, pairing QR, pairing approval). The native title bar is
    removed via WindowChrome so the top strip carries the grey-blue charter
    chrome; these buttons keep minimize/maximize/close usable.
    Close hovers with the err tinted box (the charter's low-chroma red family),
    not the saturated system red.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 10x10 caption glyphs, stroked 1.2 so they read at 100% and 150% DPI -->
    <Geometry x:Key="CsGlyphMinimize">M0,5 H10</Geometry>
    <Geometry x:Key="CsGlyphMaximize">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
    <Geometry x:Key="CsGlyphRestore">M2.5,2.5 V0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z</Geometry>
    <Geometry x:Key="CsGlyphClose">M0,0 L10,10 M10,0 L0,10</Geometry>

    <!-- Quiet caption button: transparent, hover = one lightness step down -->
    <Style x:Key="CsCaptionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
        <Setter Property="Width" Value="42" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsSurfaceInBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsLineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close: err tinted box on hover (charter red family, muted) -->
    <Style x:Key="CsCaptionCloseButton"
           BasedOn="{StaticResource CsCaptionButton}"
           TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsErrBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CsErrBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsErrLineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caption glyph path: inherits the button's foreground as stroke -->
    <Style x:Key="CsCaptionGlyph" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
