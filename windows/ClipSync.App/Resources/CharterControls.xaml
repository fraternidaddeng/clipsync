<!--
    Shared charter controls: the three type voices, the brand polyline, and the
    button family. Lives at App scope so the pairing windows speak the same
    language as the main window instead of falling back to system defaults.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Three voices (tokens.md §6), all shipped with the package (Resources/Fonts/,
         resolved relative to this dictionary): Plus Jakarta Sans carries Latin, Noto Sans SC
         carries Chinese, JetBrains Mono is the machine voice (never used for Chinese — CJK
         characters inside mono runs fall through to the bundled Noto Sans SC, then Consolas
         only if the embedded faces fail to load).
         Serif ships the single SemiBold weight of Noto Serif SC (~11 MB) for its three charter
         appearances (brand, empty state, pairing) — the size verdict was already accepted on
         Android, and SimSun must never carry the brand voice. The GDI-style family name
         ("Noto Serif SC SemiBold") is listed after the typographic one as a resolver hedge. -->
    <FontFamily x:Key="CsSans">./Fonts/#Plus Jakarta Sans, ./Fonts/#Noto Sans SC, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="CsSerif">./Fonts/#Noto Serif SC, ./Fonts/#Noto Serif SC SemiBold, Noto Serif SC, SimSun, Georgia</FontFamily>
    <FontFamily x:Key="CsMono">./Fonts/#JetBrains Mono, ./Fonts/#Noto Sans SC, Consolas</FontFamily>

    <!-- The polyline mark (24 grid) and the phone glyph, shared across windows -->
    <Geometry x:Key="IconConduit">M4,12 H8 L10,7 L14,17 L16,12 H20</Geometry>
    <Geometry x:Key="IconPhone">M8,2 H16 A3,3 0 0 1 19,5 V19 A3,3 0 0 1 16,22 H8 A3,3 0 0 1 5,19 V5 A3,3 0 0 1 8,2 Z M11,19 H13</Geometry>

    <!-- 主按钮：一屏唯一实心 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CsOnFlowBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource CsFlowBrush}"
                            CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 警示实心按钮：赭色，仅用于「证书替换」级别的责任确认 -->
    <Style x:Key="ActSolidButton"
           BasedOn="{StaticResource PrimaryButton}"
           TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource CsActBrush}"
                            CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵按钮 · 流动蓝描边 -->
    <Style x:Key="GhostFlowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CsFlowBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource CsFlowBgBrush}"
                            BorderBrush="{DynamicResource CsFlowLineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsFlowBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CsOnFlowBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵按钮 · 安静灰 -->
    <Style x:Key="GhostQuietButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource CsLine2Brush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsSurface3Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵按钮 · 红描边（error 家族唯一出场处：撤销设备） -->
    <Style x:Key="GhostDangerButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CsErrBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource CsErrLineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsErrBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
