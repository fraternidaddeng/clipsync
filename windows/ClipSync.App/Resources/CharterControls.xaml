<!--
    Shared charter controls: the three type voices, the brand polyline, and the
    button family. Lives at App scope so the pairing windows speak the same
    language as the main window instead of falling back to system defaults.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:win="clr-namespace:System.Windows;assembly=PresentationFramework">

    <!-- 历史字号/预览行数（settings-roadmap P0-1 / P1-7）：内容文字的字号阶收敛为
         DynamicResource。这里只是「标准 · 4 行」的初始值；启动与改动时由
         HistoryTypeScaleManager 按设置写入实际值。Chrome（组头/注记盒/元信息/按钮）
         不在此列，保持纲领类型阶定死。 -->
    <sys:Double x:Key="CsHistoryBodyFontSize">13</sys:Double>
    <sys:Double x:Key="CsHistoryBodyLineHeight">18</sys:Double>
    <sys:Double x:Key="CsHistoryPreviewMaxHeight">72</sys:Double>
    <sys:Double x:Key="CsDetailBodyFontSize">13</sys:Double>
    <sys:Double x:Key="CsFlyoutBodyFontSize">12</sys:Double>
    <sys:Double x:Key="CsFlyoutBodyLineHeight">18</sys:Double>
    <sys:Double x:Key="CsFlyoutBodyMaxHeight">36</sys:Double>

    <!-- 页面/次级面切换过渡（ui-gap-audit P2 动效令牌）：可见即以宪章缓动
         cubic-bezier(.16,1,.3,1) 在 dur-win 200ms 内淡入，对齐 Android tab Crossfade。
         主窗三页与详情窗共用；系统关闭动画（减弱动效）时条件不成立、保持硬切——
         系统的选择是事实。托盘浮窗刻意不接（无时间性动效是其既有裁决）。 -->
    <Storyboard x:Key="PageFadeIn">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
            <SplineDoubleKeyFrame KeySpline="0.16,1 0.3,1"
                                  KeyTime="0:0:0.2"
                                  Value="1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <!-- Grid（历史页/详情窗）与 ScrollViewer（通路/偏好页）各一份：ScrollViewer 必须
         BasedOn 主题默认样式，否则显式 Style 会丢掉滚动条模板。 -->
    <Style x:Key="PageFadeGrid" TargetType="Grid">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Path=(win:SystemParameters.ClientAreaAnimation)}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PageFadeIn}" />
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PageFadeScroll"
           BasedOn="{StaticResource {x:Type ScrollViewer}}"
           TargetType="ScrollViewer">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Path=(win:SystemParameters.ClientAreaAnimation)}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource PageFadeIn}" />
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Three voices (tokens.md §6), all shipped with the package (Resources/Fonts/,
         resolved relative to this dictionary): Plus Jakarta Sans carries Latin, Noto Sans SC
         carries Chinese, JetBrains Mono is the machine voice (never used for Chinese — CJK
         characters inside mono runs fall through to the bundled Noto Sans SC, then Consolas
         only if the embedded faces fail to load).
         Serif ships the single SemiBold weight of Noto Serif SC (~11 MB) for its three charter
         appearances (brand, empty state, pairing) — the size verdict was already accepted on
         Android, and SimSun must never carry the brand voice. The GDI-style family name
         ("Noto Serif SC SemiBold") is listed after the typographic one as a resolver hedge. -->
    <FontFamily x:Key="CsSans">./Fonts/#Plus Jakarta Sans, ./Fonts/#Noto Sans SC, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="CsSerif">./Fonts/#Noto Serif SC, ./Fonts/#Noto Serif SC SemiBold, Noto Serif SC, SimSun, Georgia</FontFamily>
    <FontFamily x:Key="CsMono">./Fonts/#JetBrains Mono, ./Fonts/#Noto Sans SC, Consolas</FontFamily>

    <!-- The polyline mark (24 grid) and the phone glyph, shared across windows -->
    <Geometry x:Key="IconConduit">M4,12 H8 L10,7 L14,17 L16,12 H20</Geometry>
    <Geometry x:Key="IconPhone">M8,2 H16 A3,3 0 0 1 19,5 V19 A3,3 0 0 1 16,22 H8 A3,3 0 0 1 5,19 V5 A3,3 0 0 1 8,2 Z M11,19 H13</Geometry>

    <!-- 主按钮：一屏唯一实心 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CsOnFlowBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource CsFlowBrush}"
                            CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 警示实心按钮：赭色，仅用于「证书替换」级别的责任确认 -->
    <Style x:Key="ActSolidButton"
           BasedOn="{StaticResource PrimaryButton}"
           TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource CsActBrush}"
                            CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵按钮 · 流动蓝描边 -->
    <Style x:Key="GhostFlowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CsFlowBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource CsFlowBgBrush}"
                            BorderBrush="{DynamicResource CsFlowLineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsFlowBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CsOnFlowBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵按钮 · 安静灰 -->
    <Style x:Key="GhostQuietButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CsText3Brush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource CsLine2Brush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsSurface3Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CsText1Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵按钮 · 红描边（error 家族唯一出场处：撤销设备） -->
    <Style x:Key="GhostDangerButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource CsErrBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource CsErrLineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsErrBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
