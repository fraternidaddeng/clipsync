<Window x:Class="ClipSync.App.Pairing.PairingApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClipSync.App.Localization"
        Title="{x:Static loc:Strings.Approval_Title}"
        Icon="/Assets/Icons/app.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource CsBgSolidBrush}"
        FontFamily="{StaticResource CsSans}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel Background="{DynamicResource CsBgBrush}">

        <!-- 标题栏：关闭 = 拒绝（协议第 9 节：未批准即拒绝） -->
        <Border DockPanel.Dock="Top"
                Height="42"
                Padding="16,0,0,0"
                Background="{DynamicResource CsSurface3Brush}"
                BorderBrush="{DynamicResource CsLineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconConduit}"
                                  Stroke="{DynamicResource CsFlowBrush}"
                                  StrokeThickness="1.9"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CsSerif}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CsText1Brush}"
                               Text="{x:Static loc:Strings.Approval_Title}" />
                </StackPanel>
                <Button Grid.Column="1"
                        AutomationProperties.Name="{x:Static loc:Strings.Approval_CloseReject}"
                        Click="OnRejectClicked"
                        Style="{StaticResource CsCaptionCloseButton}">
                    <Path Data="{StaticResource CsGlyphClose}" Style="{StaticResource CsCaptionGlyph}" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Margin="24,18,24,20">
            <TextBlock FontFamily="{StaticResource CsSerif}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CsText1Brush}"
                       Text="{x:Static loc:Strings.Approval_Question}" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource CsText2Brush}"
                       Text="{x:Static loc:Strings.Approval_Body}"
                       TextWrapping="Wrap" />

            <!-- 请求方：设备邻近色着色盒（顺位 1 · 青灰），身份用形 -->
            <Border Margin="0,16,0,0"
                    Padding="14,12"
                    Background="{DynamicResource CsSurfaceBrush}"
                    BorderBrush="{DynamicResource CsLineBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{DynamicResource CsDev1BgBrush}"
                            BorderBrush="{DynamicResource CsDev1LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource IconPhone}"
                                      Stroke="{DynamicResource CsDev1Brush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="DeviceNameText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource CsText1Brush}" />
                        <TextBlock x:Name="PlatformText"
                                   Margin="0,2,0,0"
                                   FontFamily="{StaticResource CsMono}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource CsText4Brush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 重配对 = 替换旧密钥：真正的 error 级警示，红色在此出场 -->
            <Border x:Name="RepairWarningBox"
                    Margin="0,12,0,0"
                    Padding="12,10"
                    Background="{DynamicResource CsErrBgBrush}"
                    BorderBrush="{DynamicResource CsErrLineBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="Collapsed">
                <TextBlock FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CsErrBrush}"
                           Text="{x:Static loc:Strings.Approval_RepairWarning}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 同名替换：同一部手机换了身份重新配对；赭色提醒，批准即替换旧记录 -->
            <Border x:Name="SupersedeNoticeBox"
                    Margin="0,12,0,0"
                    Padding="12,10"
                    Background="{DynamicResource CsActBgBrush}"
                    BorderBrush="{DynamicResource CsActLineBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="Collapsed">
                <TextBlock FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CsActBrush}"
                           Text="{x:Static loc:Strings.Approval_SupersedeNotice}"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="100"
                        Click="OnRejectClicked"
                        Content="{x:Static loc:Strings.Approval_Reject}"
                        Style="{StaticResource GhostQuietButton}" />
                <Button MinWidth="120"
                        Margin="10,0,0,0"
                        Click="OnApproveClicked"
                        Content="{x:Static loc:Strings.Approval_Approve}"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
