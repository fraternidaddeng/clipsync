<Window x:Class="ClipSync.App.Pairing.PairingQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ClipSync.App.Localization"
        Title="{x:Static loc:Strings.Pairing_Title}"
        Icon="/Assets/Icons/app.ico"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource CsBgSolidBrush}"
        FontFamily="{StaticResource CsSans}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <!-- 与主窗一致的自绘 chrome：配对是仪式，不该顶着一条系统白条出场 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel Background="{DynamicResource CsBgBrush}">

        <!-- 标题栏：折线标记 + 窗名（Serif，配对仪式是全应用三处衬线之一） -->
        <Border DockPanel.Dock="Top"
                Height="42"
                Padding="16,0,0,0"
                Background="{DynamicResource CsSurface3Brush}"
                BorderBrush="{DynamicResource CsLineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconConduit}"
                                  Stroke="{DynamicResource CsFlowBrush}"
                                  StrokeThickness="1.9"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CsSerif}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CsText1Brush}"
                               Text="{x:Static loc:Strings.Pairing_Title}" />
                </StackPanel>
                <Button Grid.Column="1"
                        AutomationProperties.Name="{x:Static loc:Strings.Common_Close}"
                        Click="OnCloseClicked"
                        Style="{StaticResource CsCaptionCloseButton}">
                    <Path Data="{StaticResource CsGlyphClose}" Style="{StaticResource CsCaptionGlyph}" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Margin="24,18,24,20">
            <TextBlock FontSize="11.5"
                       Foreground="{DynamicResource CsText3Brush}"
                       Text="{x:Static loc:Strings.Pairing_ScanInstruction}"
                       TextWrapping="Wrap" />

            <!-- 二维码：静区必须纯白（灰蓝底会干扰识别）；四角定位框用流动蓝提示「入口」 -->
            <Grid Margin="0,16,0,0" HorizontalAlignment="Center">
                <Border Margin="7"
                        Padding="12"
                        Background="{DynamicResource CsQrQuietBrush}"
                        BorderBrush="{DynamicResource CsLineBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <!-- 初始 280dip 占位；代码按 DPI 取整模块后精确覆盖尺寸（模块=整物理像素）。
                         NearestNeighbor 兜底：万一残余亚像素缩放，模块边缘保持硬切不糊 -->
                    <Image x:Name="QrImage"
                           Width="280"
                           Height="280"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True" />
                </Border>
                <Path HorizontalAlignment="Left" VerticalAlignment="Top"
                      Data="M0,22 V6 A6,6 0 0 1 6,0 H22"
                      Stroke="{DynamicResource CsFlowBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Top"
                      Data="M0,0 H16 A6,6 0 0 1 22,6 V22"
                      Stroke="{DynamicResource CsFlowBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Data="M22,0 V16 A6,6 0 0 1 16,22 H0"
                      Stroke="{DynamicResource CsFlowBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Data="M22,22 H6 A6,6 0 0 1 0,16 V0"
                      Stroke="{DynamicResource CsFlowBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>

            <!-- 倒计时是机器的声音：Mono -->
            <TextBlock x:Name="CountdownText"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontFamily="{StaticResource CsMono}"
                       FontSize="11"
                       Foreground="{DynamicResource CsText4Brush}" />

            <!-- 无可达地址 = 需要你操作（赭色着色盒），不是错误 -->
            <Border x:Name="NoHostsBox"
                    Margin="0,12,0,0"
                    Padding="12,10"
                    Background="{DynamicResource CsActBgBrush}"
                    BorderBrush="{DynamicResource CsActLineBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Visibility="Collapsed">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource CsActBrush}"
                           Text="{x:Static loc:Strings.Pairing_NoLanAddress}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 核对卡：指纹是全应用风险最高的比对，四位一组、等宽、t1 最高对比 -->
            <Border Margin="0,16,0,0"
                    Padding="14,11"
                    Background="{DynamicResource CsSurfaceBrush}"
                    BorderBrush="{DynamicResource CsLineBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontFamily="{StaticResource CsMono}"
                               FontSize="10"
                               Foreground="{DynamicResource CsText4Brush}"
                               Text="{x:Static loc:Strings.Pairing_VerifyHeading}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource CsText3Brush}"
                               Text="{x:Static loc:Strings.Pairing_PcName}" />
                    <TextBlock x:Name="DeviceNameText"
                               Margin="0,1,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CsText1Brush}" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource CsText3Brush}"
                               Text="{x:Static loc:Strings.Pairing_Fingerprint}" />
                    <TextBlock x:Name="FingerprintText"
                               Margin="0,2,0,0"
                               FontFamily="{StaticResource CsMono}"
                               FontSize="13"
                               LineHeight="22"
                               Foreground="{DynamicResource CsText1Brush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="110"
                        Click="OnRegenerateClicked"
                        Content="{x:Static loc:Strings.Pairing_NewCode}"
                        Style="{StaticResource GhostFlowButton}" />
                <Button MinWidth="110"
                        Margin="10,0,0,0"
                        Click="OnCloseClicked"
                        Content="{x:Static loc:Strings.Common_Close}"
                        Style="{StaticResource GhostQuietButton}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
