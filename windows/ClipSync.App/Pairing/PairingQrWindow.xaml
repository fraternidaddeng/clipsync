<Window x:Class="ClipSync.App.Pairing.PairingQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:ClipSync.App"
        Title="{x:Static app:Strings.PairingQrTitle}"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" Background="White">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Static app:Strings.PairingQrHeader}" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#5E6672"
                   Text="{x:Static app:Strings.PairingQrHint}" />
        <Border Margin="0,16,0,0" Padding="12" HorizontalAlignment="Center"
                Background="White" BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="6">
            <Image x:Name="QrImage" Width="300" Height="300" SnapsToDevicePixels="True" />
        </Border>
        <TextBlock x:Name="CountdownText" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="#5E6672" />
        <TextBlock x:Name="NoHostsText"
                   Margin="0,12,0,0"
                   Foreground="#A4262C"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Text="{x:Static app:Strings.PairingNoHosts}" />
        <Separator Margin="0,16,0,12" />
        <TextBlock FontWeight="SemiBold" Text="{x:Static app:Strings.PairingVerifyHeader}" />
        <TextBlock x:Name="DeviceNameText" Margin="0,8,0,0" Foreground="#3B424C" />
        <TextBlock x:Name="FingerprintText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12"
                   Foreground="#3B424C" TextWrapping="Wrap" />
        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="120" Height="32" Click="OnRegenerateClicked" Content="{x:Static app:Strings.PairingNewCode}" />
            <Button Width="120" Height="32" Margin="10,0,0,0" Click="OnCloseClicked" Content="{x:Static app:Strings.Close}" />
        </StackPanel>
    </StackPanel>
</Window>
